.cvs button.on{border-color:var(--text)}
.ed-av{display:flex;align-items:center;gap:14px;margin-bottom:14px}
</style>

<script>
(function(){
const $=Z.$;
Object.assign(Z.T.en,{s6_set:'Settings',s6_edit:'Edit profile',s6_posts:'Posts',s6_vid:'Videos',s6_live:'Live',s6_likes:'Likes',s6_joined:'Joined',s6_nop:'No posts yet. Tap Create to share your first one!',s6_nov:'No videos yet.',s6_nol:'No live streams yet. Go live from the Chat tab.',s6_name:'Name',s6_bio:'Bio',s6_photo:'Change photo',s6_cover:'Cover colour',s6_save:'Save',s6_ok:'Profile updated.',s6_del:'Delete post',s6_dc:'Delete this post?',s6_ended:'Ended',s6_cm:'comments',s6_close:'Close'});
Object.assign(Z.T.bn,{s6_set:'সেটিংস',s6_edit:'প্রোফাইল এডিট',s6_posts:'পোস্ট',s6_vid:'ভিডিও',s6_live:'লাইভ',s6_likes:'লাইক',s6_joined:'যোগ দিয়েছেন',s6_nop:'এখনো কোনো পোস্ট নেই। Create চেপে প্রথম পোস্ট করুন!',s6_nov:'এখনো কোনো ভিডিও নেই।',s6_nol:'এখনো কোনো লাইভ নেই। Chat ট্যাব থেকে লাইভে যান।',s6_name:'নাম',s6_bio:'বায়ো',s6_photo:'ছবি বদলান',s6_cover:'কভারের রঙ',s6_save:'সেভ',s6_ok:'প্রোফাইল আপডেট হয়েছে।',s6_del:'পোস্ট ডিলিট',s6_dc:'এই পোস্ট ডিলিট করবেন?',s6_ended:'শেষ হয়েছে',s6_cm:'কমেন্ট',s6_close:'বন্ধ'});

const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ld=(k,d=[])=>{try{const v=JSON.parse(localStorage[k]);return v==null?d:v}catch(e){return d}};
const sv=(k,v)=>{try{localStorage[k]=JSON.stringify(v);return true}catch(e){alert(Z.t('full'));return false}};
const fmt=n=>n>=1e6?(n/1e6).toFixed(1)+'M':n>=1e3?(n/1e3).toFixed(1)+'K':n;
const ago=ts=>{const m=Math.floor((Date.now()-ts)/6e4);return m<1?Z.t('now'):m<60?m+'m':m<1440?Math.floor(m/60)+'h':Math.floor(m/1440)+'d'};
const cur=()=>ld('zv_users').find(u=>u.id===Z.user.id)||Z.user;
const COVERS=['linear-gradient(135deg,#1e5bff,#8a2be2)','linear-gradient(135deg,#ff2d75,#8a2be2)','linear-gradient(135deg,#00c6ff,#1e5bff)','linear-gradient(135deg,#f7b500,#ff2d75)','linear-gradient(135deg,#0a1a5c,#8a2be2)'];
const bd=u=>u.verified==='vip_pro'?'<span class="bdg vip">👑 PRO</span>':u.verified==='identity'?'<span class="bdg id">✔</span>':'';
function patch(fn){const L=ld('zv_users'),u=L.find(x=>x.id===Z.user.id);if(!u)return false;fn(u);if(!sv('zv_users',L))return false;Object.assign(Z.user,u);return true}

/* ---- premium toast (replaces blocking alert) ---- */
const te=document.createElement('div');te.id='toast';document.body.appendChild(te);let tt;
window.alert=m=>{te.textContent=m;te.classList.add('on');clearTimeout(tt);tt=setTimeout(()=>te.classList.remove('on'),2700)};

/* ---- video thumbnails (same IndexedDB as Part 3) ---- */
const getBlob=id=>new Promise(res=>{const r=indexedDB.open('zv_videos',1);r.onupgradeneeded=()=>r.result.createObjectStore('v');
  r.onsuccess=()=>{try{const q=r.result.transaction('v').objectStore('v').get(id);q.onsuccess=()=>res(q.result);q.onerror=()=>res(null)}catch(e){res(null)}};r.onerror=()=>res(null)});
let urls=[];

function modal(html){
  const d=document.createElement('div');d.className='m4';d.innerHTML=`<div class="m4b">${html}</div>`;
  d.addEventListener('click',e=>{if(e.target===d){d.remove()}});document.body.appendChild(d);return d;
}
const sq=f=>new Promise(res=>{const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const s=Math.min(im.width,im.height),c=document.createElement('canvas');c.width=c.height=300;
  c.getContext('2d').drawImage(im,(im.width-s)/2,(im.height-s)/2,s,s,0,0,300,300);res(c.toDataURL('image/jpeg',.8))};im.src=r.result};r.readAsDataURL(f)});

let root,tab='posts',inSet=false;
const P5=Z.views.profile;   // Part 5 screen = Settings hub

/* ---------- Settings hub (Wallet, Verification, Studio, Settings, Admin, Logout) ---------- */
function settingsV(el){
  el.innerHTML=`<div class="sethead"><button class="ic" data-x="exit">←</button>⚙️ ${Z.t('s6_set')}</div><div id="s6c"></div>`;
  el.onclick=null;
  el.querySelector('[data-x=exit]').onclick=()=>{inSet=false;profile(el)};
  P5(el.querySelector('#s6c'));
}

/* ---------- Profile ---------- */
function profile(el){
  root=el;
  if(inSet)return settingsV(el);
  urls.forEach(u=>URL.revokeObjectURL(u));urls=[];
  const u=cur(),posts=ld('zv_posts').filter(p=>p.uid===u.id).sort((a,b)=>b.ts-a.ts),
    vids=ld('zv_videos').filter(v=>v.uid===u.id).sort((a,b)=>b.ts-a.ts),
    lives=ld('zv_lives').filter(l=>l.uid===u.id).sort((a,b)=>b.ts-a.ts),
    likes=posts.reduce((s,p)=>s+p.likes.length,0)+vids.reduce((s,v)=>s+v.likes.length,0);
  const T=(k,l,n)=>`<button class="${tab===k?'on':''}" data-x="tab" data-t="${k}">${l} · ${n}</button>`;
  let body='';
  if(tab==='posts')body=posts.length?`<div class="gd">${posts.map(p=>`<div data-x="post" data-id="${p.id}">${p.img?`<img src="${p.img}" alt="">`:`<div class="tx">${esc((p.text||'').slice(0,90))}</div>`}<div class="ov">❤️ ${p.likes.length} · 💬 ${p.comments.length}</div></div>`).join('')}</div>`:`<div class="ph">${Z.t('s6_nop')}</div>`;
  else if(tab==='videos')body=vids.length?`<div class="gd">${vids.map(v=>`<div data-x="vid" data-id="${v.id}"><video muted playsinline preload="metadata" data-v="${v.id}"></video><div class="ov">▶ ${fmt(v.views)} · ❤️ ${v.likes.length}</div></div>`).join('')}</div>`:`<div class="ph">${Z.t('s6_nov')}</div>`;
  else body=lives.length?lives.map(l=>{const on=!l.ended&&Date.now()-(+localStorage['zv_bt_'+l.id]||0)<10000;
    return `<div class="row4" style="cursor:default"><div class="av" style="${on?'background:#e11':''}">${on?'●':'🔴'}</div><div class="t"><b>${esc(l.title)}</b><div>${new Date(l.ts).toLocaleDateString()} · 💬 ${l.c.length} ${Z.t('s6_cm')}</div></div>${on?'<span class="bdg" style="background:#e11">LIVE</span>':`<span class="sm">${Z.t('s6_ended')}</span>`}</div>`}).join(''):`<div class="ph">${Z.t('s6_nol')}</div>`;

  el.innerHTML=`<div class="pf-cover" style="background:${COVERS[u.cover||0]}"><button class="pf-ic" data-x="settings">⚙️</button></div>
  <div class="pf-top"><div class="pf-av">${u.avatar?`<img src="${u.avatar}" alt="">`:esc(u.name[0].toUpperCase())}</div><button class="pf-edit" data-x="edit">✏️ ${Z.t('s6_edit')}</button></div>
  <div class="pf-name">${esc(u.name)}${bd(u)}</div>
  <div class="sm" style="padding:2px 4px">${esc(u.email)} · ${Z.t('s6_joined')} ${new Date(u.created||Date.now()).toLocaleDateString()}</div>
  ${u.bio?`<div class="pf-bio">${esc(u.bio)}</div>`:''}
  <div class="pf-st"><div><b>${posts.length}</b>${Z.t('s6_posts')}</div><div><b>${vids.length}</b>${Z.t('s6_vid')}</div><div><b>${lives.length}</b>${Z.t('s6_live')}</div><div><b>${likes}</b>${Z.t('s6_likes')}</div></div>
  <div class="pf-tabs">${T('posts','▦ '+Z.t('s6_posts'),posts.length)}${T('videos','▶ '+Z.t('s6_vid'),vids.length)}${T('live','🔴 '+Z.t('s6_live'),lives.length)}</div>${body}`;

  el.querySelectorAll('video[data-v]').forEach(async v=>{
    const b=await getBlob(v.dataset.v);if(!b)return;
    const url=URL.createObjectURL(b);urls.push(url);v.src=url+'#t=0.1';
  });

  el.onclick=async e=>{
    const b=e.target.closest('[data-x]');if(!b)return;
    const x=b.dataset.x,id=b.dataset.id;
    if(x==='settings'){inSet=true;profile(el)}
    else if(x==='tab'){tab=b.dataset.t;profile(el)}
    else if(x==='edit')edit(el);
    else if(x==='post'){
      const p=ld('zv_posts').find(q=>q.id===id);if(!p)return;
      const d=modal(`<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px"><b>${esc(p.cat)} · ${ago(p.ts)}</b><button class="ic" data-c="1">✕</button></div>
      ${p.img?`<img src="${p.img}" style="width:100%;border-radius:14px;margin-bottom:10px" alt="">`:''}${p.text?`<p style="white-space:pre-wrap;word-break:break-word;line-height:1.5;margin-bottom:10px">${esc(p.text)}</p>`:''}
      <p class="sm" style="margin-bottom:12px">❤️ ${p.likes.length} · 💬 ${p.comments.length} · ↗️ ${p.shares} · 🔖 ${p.saves.length}</p>
      <button class="btn" style="background:#dc2626;box-shadow:none" data-d="1">🗑 ${Z.t('s6_del')}</button>`);
      d.querySelector('[data-c]').onclick=()=>d.remove();
      d.querySelector('[data-d]').onclick=()=>{if(!confirm(Z.t('s6_dc')))return;sv('zv_posts',ld('zv_posts').filter(q=>q.id!==id));d.remove();profile(el)};
    }
    else if(x==='vid'){
      const v=ld('zv_videos').find(q=>q.id===id);if(!v)return;
      const bl=await getBlob(id);
      const d=modal(`<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px"><b style="flex:1;margin-right:8px">${esc(v.title)}</b><button class="ic" data-c="1">✕</button></div>
      <video controls autoplay playsinline style="width:100%;border-radius:14px;background:#000;max-height:60vh"></video>
      <p class="sm" style="margin-top:10px">👁 ${fmt(v.views)} · ❤️ ${v.likes.length} · 💬 ${v.comments.length}</p>`);
      let u2='';if(bl){u2=URL.createObjectURL(bl);d.querySelector('video').src=u2}
      const close=()=>{if(u2)URL.revokeObjectURL(u2);d.remove()};
      d.querySelector('[data-c]').onclick=close;d.addEventListener('click',ev=>{if(ev.target===d)close()});
    }
  };
}

/* ---------- Edit profile ---------- */
function edit(el){
  const u=cur();let av=u.avatar||'',cv=u.cover||0;
  const d=modal(`<h3 style="margin-bottom:12px">✏️ ${Z.t('s6_edit')}</h3>
  <div class="ed-av"><div class="pf-av" id="e-av" style="width:76px;height:76px;font-size:30px;border-width:3px">${av?`<img src="${av}" alt="">`:esc(u.name[0].toUpperCase())}</div><button class="pf-edit" id="e-ph">📷 ${Z.t('s6_photo')}</button></div>
  <input class="inp" id="e-n" maxlength="50" value="${esc(u.name)}" placeholder="${Z.t('s6_name')}">
  <textarea class="inp" id="e-b" rows="3" maxlength="160" placeholder="${Z.t('s6_bio')}">${esc(u.bio||'')}</textarea>
  <div class="sm">${Z.t('s6_cover')}</div><div class="cvs">${COVERS.map((c,i)=>`<button data-i="${i}" class="${i===cv?'on':''}" style="background:${c}"></button>`).join('')}</div>
  <button class="btn" id="e-go">${Z.t('s6_save')}</button>`);
  d.querySelector('#e-ph').onclick=()=>{const i=document.createElement('input');i.type='file';i.accept='image/*';
    i.onchange=async()=>{if(!i.files[0])return;av=await sq(i.files[0]);d.querySelector('#e-av').innerHTML=`<img src="${av}" alt="">`};i.click()};
  d.querySelector('.cvs').onclick=e=>{const b=e.target.closest('button');if(!b)return;cv=+b.dataset.i;d.querySelectorAll('.cvs button').forEach(x=>x.classList.toggle('on',x===b))};
  d.querySelector('#e-go').onclick=()=>{
    const n=d.querySelector('#e-n').value.trim();if(!n)return;
    if(patch(x=>{x.name=n;x.bio=d.querySelector('#e-b').value.trim();x.avatar=av;x.cover=cv})){d.remove();alert(Z.t('s6_ok'));profile(el)}
  };
}

/* leaving Profile (or tapping it again) always returns to the profile page, never stuck in Settings */
$('nav').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
  if(b.dataset.k!=='profile'||Z.tab==='profile')inSet=false;
  if(navigator.vibrate)navigator.vibrate(8)},true);

Z.views.profile=profile;
})();
</script>
