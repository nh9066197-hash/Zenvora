<style>
.stories{display:flex;gap:10px;overflow-x:auto;padding-bottom:10px;scrollbar-width:none}
.st{flex:0 0 auto;width:64px;text-align:center;font-size:11px;cursor:pointer}
.st .ring{width:60px;height:60px;border-radius:50%;padding:3px;background:var(--grad);margin:auto}
.st .ring>div{width:100%;height:100%;border-radius:50%;background:var(--card) center/cover;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:22px;border:2px solid var(--bg)}
.st.add .ring{background:var(--card)}
.st span{display:block;margin-top:3px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.chips{display:flex;gap:8px;margin-bottom:12px}
.chip{border:0;border-radius:20px;padding:6px 14px;background:var(--card);cursor:pointer;color:var(--muted)}
.chip.on{background:var(--grad);color:#fff}
.post{background:var(--card);border-radius:18px;margin-bottom:14px;overflow:hidden}
.pt-head{display:flex;gap:10px;align-items:center;padding:12px}
.av{width:38px;height:38px;border-radius:50%;background:var(--grad);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700}
.mt{font-size:12px;color:var(--muted)}
.pt-text{padding:0 14px 12px;white-space:pre-wrap;word-break:break-word;line-height:1.5}
.post>img{width:100%;display:block}
.act{display:flex;padding:4px 6px}
.act button,.x{background:none;border:0;padding:10px;font-size:15px;cursor:pointer}
.act button.on{color:var(--pink)}
.cms{padding:4px 14px 12px;border-top:1px solid var(--bg)}
.cm{font-size:14px;margin:8px 0}.cm b{margin-right:6px}
.cm-row{display:flex;gap:8px;margin-top:8px}
.cm-row input{flex:1;padding:10px 14px;border:0;border-radius:20px;background:var(--bg);outline:none}
.cm-row button{border:0;border-radius:20px;padding:0 16px;background:var(--grad);color:#fff;cursor:pointer}
textarea.inp{resize:none}
.pick{display:block;text-align:center;padding:12px;margin-bottom:12px;border:2px dashed var(--muted);border-radius:14px;color:var(--muted);cursor:pointer}
#sv{position:fixed;inset:0;background:#000;z-index:60;display:flex;flex-direction:column;align-items:center;justify-content:center}
#sv img{max-width:100%;max-height:85%}
#sv .bar{position:absolute;top:0;left:0;height:3px;background:var(--grad);width:0;transition:width 5s linear}
#sv p{position:absolute;top:16px;left:16px;color:#fff;font-weight:600}
</style>

<script>
(function(){
const $=Z.$;
Object.assign(Z.T.en,{yourStory:'Your story',mind:"What's on your mind?",photo:'Add photo',post:'Post',now:'now',comment:'Write a comment…',send:'Send',full:'Storage full. Try a smaller photo.',all:'All',saved:'Saved',empty:'Nothing here yet.',need:'Write something or add a photo.',welcome:'Welcome to ZENVORA! Connect, Create, Inspire. Share your first post today.'});
Object.assign(Z.T.bn,{yourStory:'আপনার স্টোরি',mind:'আপনার মনে কী চলছে?',photo:'ছবি যোগ করুন',post:'পোস্ট করুন',now:'এইমাত্র',comment:'কমেন্ট লিখুন…',send:'পাঠান',full:'স্টোরেজ ভরে গেছে। ছোট ছবি দিন।',all:'সব',saved:'সেভ করা',empty:'এখনো কিছু নেই।',need:'কিছু লিখুন বা ছবি দিন।',welcome:'ZENVORA-তে স্বাগতম! Connect, Create, Inspire. আজই আপনার প্রথম পোস্ট করুন।'});

const CATS=['General','News','Entertainment','Education','Gaming','Business'];
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const load=k=>{try{return JSON.parse(localStorage[k]||'[]')}catch(e){return[]}};
const save=(k,v)=>{try{localStorage[k]=JSON.stringify(v);return true}catch(e){alert(Z.t('full'));return false}};
const ago=ts=>{const m=Math.floor((Date.now()-ts)/6e4);return m<1?Z.t('now'):m<60?m+'m':m<1440?Math.floor(m/60)+'h':Math.floor(m/1440)+'d'};
const toData=(f,max=900)=>new Promise(res=>{const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const s=Math.min(1,max/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*s;c.height=im.height*s;c.getContext('2d').drawImage(im,0,0,c.width,c.height);res(c.toDataURL('image/jpeg',.75))};im.src=r.result};r.readAsDataURL(f)});

/* one clearly-labelled official welcome post (not a fake user) */
if(!localStorage.zv_seeded){
  save('zv_posts',[{id:'p0',uid:'official',name:'ZENVORA Official',official:1,text:Z.t('welcome'),img:'',cat:'News',ts:Date.now(),likes:[],saves:[],comments:[],shares:0}]);
  localStorage.zv_seeded=1;
}

const open=new Set();let onlySaved=false;

const cmHtml=p=>`<div class="cms">${p.comments.map(c=>`<div class="cm"><b>${esc(c.name)}</b>${esc(c.text)}</div>`).join('')}
<div class="cm-row"><input placeholder="${Z.t('comment')}" maxlength="300"><button data-a="send">${Z.t('send')}</button></div></div>`;

const postHtml=(p,me)=>{const lk=p.likes.includes(me);return `<article class="post" data-id="${p.id}">
<div class="pt-head"><div class="av">${esc((p.name[0]||'?').toUpperCase())}</div>
<div style="flex:1"><b>${esc(p.name)}</b>${p.official?' <span style="color:var(--blue)">✔</span>':''}<div class="mt">${ago(p.ts)} · ${esc(p.cat)}</div></div>
${p.uid===me?'<button class="x" data-a="del">🗑</button>':''}</div>
${p.text?`<p class="pt-text">${esc(p.text)}</p>`:''}${p.img?`<img src="${p.img}" alt="">`:''}
<div class="act"><button data-a="like" class="${lk?'on':''}">${lk?'❤️':'🤍'} ${p.likes.length}</button>
<button data-a="cm">💬 ${p.comments.length}</button><button data-a="share">↗️ ${p.shares}</button>
<button data-a="save" style="margin-left:auto">${p.saves.includes(me)?'🔖':'📑'}</button></div>
${open.has(p.id)?cmHtml(p):''}</article>`};

function viewStory(s){
  const d=document.createElement('div');d.id='sv';
  d.innerHTML=`<div class="bar"></div><p>${esc(s.name)} · ${ago(s.ts)}</p><img src="${s.img}" alt="">`;
  document.body.appendChild(d);
  setTimeout(()=>d.querySelector('.bar').style.width='100%',30);
  const close=()=>{clearTimeout(t);d.remove()};const t=setTimeout(close,5000);d.onclick=close;
}

function feed(el){
  const me=Z.user.id;
  let posts=load('zv_posts').sort((a,b)=>b.ts-a.ts);
  if(onlySaved)posts=posts.filter(p=>p.saves.includes(me));
  const stories=load('zv_stories').filter(s=>Date.now()-s.ts<864e5).sort((a,b)=>b.ts-a.ts);
  el.innerHTML=`<div class="stories"><div class="st add" data-a="addstory"><div class="ring"><div>＋</div></div><span>${Z.t('yourStory')}</span></div>
  ${stories.map(s=>`<div class="st" data-s="${s.id}"><div class="ring"><div style="background-image:url('${s.img}')"></div></div><span>${esc(s.name)}</span></div>`).join('')}</div>
  <div class="chips"><button class="chip ${onlySaved?'':'on'}" data-a="all">${Z.t('all')}</button><button class="chip ${onlySaved?'on':''}" data-a="onlysaved">🔖 ${Z.t('saved')}</button></div>
  <div class="card" data-a="compose" style="color:var(--muted);cursor:pointer">${Z.t('mind')}</div>
  ${posts.map(p=>postHtml(p,me)).join('')||`<div class="ph">${Z.t('empty')}</div>`}`;

  el.onclick=async e=>{
    const st=e.target.closest('[data-s]');
    if(st){const s=load('zv_stories').find(x=>x.id===st.dataset.s);if(s)viewStory(s);return}
    const b=e.target.closest('[data-a]');if(!b)return;
    const a=b.dataset.a;
    if(a==='compose'){Z.tab='create';renderNav();render();return}
    if(a==='all'||a==='onlysaved'){onlySaved=a==='onlysaved';feed(el);return}
    if(a==='addstory'){
      const i=document.createElement('input');i.type='file';i.accept='image/*';
      i.onchange=async()=>{if(!i.files[0])return;const img=await toData(i.files[0],720),ss=load('zv_stories');
        ss.push({id:'s'+Date.now(),uid:me,name:Z.user.name,img,ts:Date.now()});if(save('zv_stories',ss))feed(el)};
      i.click();return}
    const art=b.closest('article');if(!art)return;
    const all=load('zv_posts'),p=all.find(x=>x.id===art.dataset.id);if(!p)return;
    const tog=arr=>{const k=arr.indexOf(me);k<0?arr.push(me):arr.splice(k,1)};
    if(a==='like')tog(p.likes);
    else if(a==='save')tog(p.saves);
    else if(a==='cm'){open.has(p.id)?open.delete(p.id):open.add(p.id)}
    else if(a==='share'){
      const txt=(p.text||'ZENVORA').slice(0,100)+' – ZENVORA',url=location.href.split('#')[0];
      if(navigator.share)navigator.share({title:'ZENVORA',text:txt,url}).catch(()=>{});
      else if(navigator.clipboard)navigator.clipboard.writeText(txt+' '+url);
      p.shares++}
    else if(a==='send'){
      const v=art.querySelector('.cm-row input').value.trim();if(!v)return;
      p.comments.push({uid:me,name:Z.user.name,text:v,ts:Date.now()})}
    else if(a==='del'){save('zv_posts',all.filter(x=>x.id!==p.id));feed(el);return}
    save('zv_posts',all);feed(el);
  };
}

Z.views.home=feed;

Z.views.create=el=>{
  let img='';
  el.innerHTML=`<div class="card"><textarea id="p-text" class="inp" rows="5" maxlength="2000" placeholder="${Z.t('mind')}"></textarea>
  <select id="p-cat" class="inp">${CATS.map(c=>`<option>${c}</option>`).join('')}</select>
  <img id="p-prev" class="hide" style="width:100%;border-radius:14px;margin-bottom:12px" alt="">
  <label class="pick">📷 ${Z.t('photo')}<input id="p-file" type="file" accept="image/*" hidden></label>
  <button class="btn" id="p-go">${Z.t('post')}</button></div>`;
  $('p-file').onchange=async e=>{if(!e.target.files[0])return;img=await toData(e.target.files[0]);$('p-prev').src=img;$('p-prev').classList.remove('hide')};
  $('p-go').onclick=()=>{
    const text=$('p-text').value.trim();
    if(!text&&!img)return alert(Z.t('need'));
    const all=load('zv_posts');
    all.push({id:'p'+Date.now(),uid:Z.user.id,name:Z.user.name,text,img,cat:$('p-cat').value,ts:Date.now(),likes:[],saves:[],comments:[],shares:0});
    if(save('zv_posts',all)){Z.tab='home';renderNav();render()}
  };
};
})();
</script>
<!-- ===== PART 3: Watch & Short Videos ===== -->
<style>
.wbar{display:flex;gap:8px;align-items:center;margin-bottom:10px;overflow-x:auto;scrollbar-width:none}
.wbar .chip{white-space:nowrap}
.wsearch{display:flex;gap:8px;margin-bottom:10px}
.wsearch input{flex:1;padding:11px 16px;border:0;border-radius:22px;background:var(--card);outline:none}
.reels{height:calc(100vh - 210px);height:calc(100dvh - 210px);min-height:420px;overflow-y:scroll;scroll-snap-type:y mandatory;border-radius:18px;background:#000;scrollbar-width:none}
.rl{height:100%;scroll-snap-align:start;scroll-snap-stop:always;position:relative;color:#fff}
.rl video{width:100%;height:100%;object-fit:contain;background:#000}
.rl .side{position:absolute;right:8px;bottom:70px;display:flex;flex-direction:column;gap:14px;align-items:center}
.rl .side button{background:rgba(0,0,0,.45);border:0;color:#fff;border-radius:50%;width:48px;height:48px;font-size:12px;line-height:1.1;cursor:pointer}
.rl .info{position:absolute;left:12px;right:70px;bottom:16px;text-shadow:0 1px 4px #000}
.rl .info small{opacity:.9}
.vc{background:var(--card);border-radius:18px;overflow:hidden;margin-bottom:14px}
.vc video{width:100%;max-height:260px;background:#000;display:block}
.vc .m{padding:10px 14px}
.vc .r{display:flex;gap:4px;padding:0 6px 8px}
.vc .r button{background:none;border:0;padding:8px;font-size:14px;cursor:pointer}
.vc .r button.on{color:var(--pink)}
.tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.tg{background:var(--card);border:0;border-radius:14px;padding:5px 12px;color:var(--blue);cursor:pointer;font-size:13px}
.sheet{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:100%;max-width:480px;max-height:65%;background:var(--bg);border-radius:20px 20px 0 0;box-shadow:0 -6px 24px rgba(0,0,0,.35);z-index:70;display:flex;flex-direction:column;padding:14px}
.sheet .l{overflow-y:auto;flex:1;margin-bottom:8px}
</style>

<script>
(function(){
const $=Z.$;
Object.assign(Z.T.en,{shorts:'Shorts',long:'Videos',trend:'Trending',find:'Search videos, creators, #tags',upload:'Upload',novid:'No videos yet. Tap Upload to share the first one!',vtitle:'Video title (use #hashtags)',big:'Video is too large (max 80 MB).',nores:'No results.',cmw:'Write a comment…',send:'Send'});
Object.assign(Z.T.bn,{shorts:'শর্টস',long:'ভিডিও',trend:'ট্রেন্ডিং',find:'ভিডিও, ক্রিয়েটর, #ট্যাগ খুঁজুন',upload:'আপলোড',novid:'এখনো কোনো ভিডিও নেই। আপলোড চেপে প্রথম ভিডিও দিন!',vtitle:'ভিডিওর শিরোনাম (#হ্যাশট্যাগ সহ)',big:'ভিডিও অনেক বড় (সর্বোচ্চ ৮০ MB)।',nores:'কিছু পাওয়া যায়নি।',cmw:'কমেন্ট লিখুন…',send:'পাঠান'});

const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const load=()=>{try{return JSON.parse(localStorage.zv_videos||'[]')}catch(e){return[]}};
const save=v=>{try{localStorage.zv_videos=JSON.stringify(v)}catch(e){}};
const fmt=n=>n>=1e6?(n/1e6).toFixed(1)+'M':n>=1e3?(n/1e3).toFixed(1)+'K':n;
const score=v=>v.likes.length*3+v.comments.length*2+v.views;

/* video files live in IndexedDB (too big for localStorage) */
const idb=()=>new Promise((res,rej)=>{const r=indexedDB.open('zv_videos',1);r.onupgradeneeded=()=>r.result.createObjectStore('v');r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)});
const putBlob=async(id,b)=>{const d=await idb();return new Promise((res,rej)=>{const t=d.transaction('v','readwrite');t.objectStore('v').put(b,id);t.oncomplete=res;t.onerror=()=>rej(t.error)})};
const getBlob=async id=>{const d=await idb();return new Promise((res,rej)=>{const q=d.transaction('v').objectStore('v').get(id);q.onsuccess=()=>res(q.result);q.onerror=()=>rej(q.error)})};
const delBlob=async id=>{const d=await idb();return new Promise(res=>{const t=d.transaction('v','readwrite');t.objectStore('v').delete(id);t.oncomplete=res;t.onerror=res})};

let mode='shorts',q='',urls=[],io=null,tm=null;const seen=new Set();

const reel=(v,me)=>`<section class="rl" data-id="${v.id}"><video data-id="${v.id}" loop playsinline preload="metadata"></video>
<div class="side"><button data-a="like" data-id="${v.id}">${v.likes.includes(me)?'❤️':'🤍'}<br>${v.likes.length}</button>
<button data-a="cm" data-id="${v.id}">💬<br>${v.comments.length}</button>
<button data-a="share" data-id="${v.id}">↗️<br>${v.shares}</button>
${v.uid===me?`<button data-a="del" data-id="${v.id}">🗑</button>`:''}</div>
<div class="info"><b>@${esc(v.name)}</b><div>${esc(v.title)}</div><small>👁 ${fmt(v.views)}</small></div></section>`;

const card=(v,me)=>{const lk=v.likes.includes(me);return `<article class="vc"><video data-id="${v.id}" controls playsinline preload="metadata"></video>
<div class="m"><b>${esc(v.title)}</b><div style="font-size:12px;color:var(--muted)">@${esc(v.name)} · 👁 ${fmt(v.views)} · ${v.kind==='short'?'⚡':'🎬'}</div></div>
<div class="r"><button data-a="like" data-id="${v.id}" class="${lk?'on':''}">${lk?'❤️':'🤍'} ${v.likes.length}</button>
<button data-a="cm" data-id="${v.id}">💬 ${v.comments.length}</button>
<button data-a="share" data-id="${v.id}">↗️ ${v.shares}</button>
${v.uid===me?`<button data-a="del" data-id="${v.id}" style="margin-left:auto">🗑</button>`:''}</div></article>`};

const upd=(v,me)=>document.querySelectorAll(`[data-id="${v.id}"][data-a]`).forEach(b=>{
  const sep=b.closest('.rl')?'<br>':' ',a=b.dataset.a;
  if(a==='like'){b.innerHTML=(v.likes.includes(me)?'❤️':'🤍')+sep+v.likes.length;b.classList.toggle('on',v.likes.includes(me))}
  if(a==='cm')b.innerHTML='💬'+sep+v.comments.length;
  if(a==='share')b.innerHTML='↗️'+sep+v.shares;
});

function view(id){
  if(seen.has(id))return;seen.add(id);
  const a=load(),v=a.find(x=>x.id===id);if(v){v.views++;save(a)}
}

function sheet(id,me){
  const d=document.createElement('div');d.className='sheet';
  const draw=()=>{
    const v=load().find(x=>x.id===id);if(!v)return d.remove();
    d.innerHTML=`<div style="display:flex;justify-content:space-between;margin-bottom:8px"><b>💬 ${v.comments.length}</b><button data-c="1" style="background:none;border:0;font-size:18px;cursor:pointer">✕</button></div>
    <div class="l">${v.comments.map(c=>`<div style="font-size:14px;margin:8px 0"><b>${esc(c.name)}</b> ${esc(c.text)}</div>`).join('')}</div>
    <div class="cm-row"><input maxlength="300" placeholder="${Z.t('cmw')}"><button data-s="1">${Z.t('send')}</button></div>`;
    d.querySelector('[data-c]').onclick=()=>d.remove();
    d.querySelector('[data-s]').onclick=()=>{
      const t=d.querySelector('input').value.trim();if(!t)return;
      const a=load(),vv=a.find(x=>x.id===id);
      vv.comments.push({uid:me,name:Z.user.name,text:t,ts:Date.now()});save(a);upd(vv,me);draw();
    };
  };
  draw();document.body.appendChild(d);
}

function pick(el){
  const i=document.createElement('input');i.type='file';i.accept='video/*';
  i.onchange=async()=>{
    const f=i.files[0];if(!f)return;
    if(f.size>80*1048576)return alert(Z.t('big'));
    const title=(prompt(Z.t('vtitle'),'')||'').trim().slice(0,120)||f.name.replace(/\.[^.]+$/,'');
    const dur=await new Promise(res=>{const t=document.createElement('video'),u=URL.createObjectURL(f);t.preload='metadata';t.onloadedmetadata=()=>{URL.revokeObjectURL(u);res(t.duration||0)};t.onerror=()=>res(0);t.src=u});
    const id='v'+Date.now();
    try{await putBlob(id,f)}catch(e){return alert(Z.t('big'))}
    const tags=[...new Set((title.match(/#[\p{L}\p{N}_]+/gu)||[]).map(t=>t.slice(1).toLowerCase()))];
    const a=load();
    a.push({id,uid:Z.user.id,name:Z.user.name,title,tags,kind:dur>60?'long':'short',ts:Date.now(),likes:[],comments:[],shares:0,views:0});
    save(a);mode=dur>60?'long':'shorts';watch(el);
  };
  i.click();
}

function watch(el){
  urls.forEach(u=>URL.revokeObjectURL(u));urls=[];if(io)io.disconnect();
  const me=Z.user.id,all=load();let list;
  if(mode==='shorts')list=all.filter(v=>v.kind==='short').sort((a,b)=>b.ts-a.ts);
  else if(mode==='long')list=all.filter(v=>v.kind==='long').sort((a,b)=>b.ts-a.ts);
  else if(mode==='trend')list=[...all].sort((a,b)=>score(b)-score(a));
  else{const s=q.toLowerCase().replace(/^#/,'');list=all.filter(v=>(v.title+' '+v.name+' '+v.tags.join(' ')).toLowerCase().includes(s)).sort((a,b)=>score(b)-score(a))}
  const cnt={};all.forEach(v=>v.tags.forEach(t=>cnt[t]=(cnt[t]||0)+1));
  const top=Object.keys(cnt).sort((a,b)=>cnt[b]-cnt[a]).slice(0,8);
  const chip=(m,l)=>`<button class="chip ${mode===m?'on':''}" data-a="mode" data-m="${m}">${l}</button>`;
  el.innerHTML=`<div class="wbar">${chip('shorts','⚡ '+Z.t('shorts'))}${chip('long','🎬 '+Z.t('long'))}${chip('trend','🔥 '+Z.t('trend'))}${chip('search','🔍')}<button class="chip on" data-a="upload">⬆ ${Z.t('upload')}</button></div>
  ${mode==='search'?`<div class="wsearch"><input id="w-q" value="${esc(q)}" placeholder="${Z.t('find')}"></div>`:''}
  ${(mode==='trend'||mode==='search')&&top.length?`<div class="tags">${top.map(t=>`<button class="tg" data-a="tag" data-t="${esc(t)}">#${esc(t)}</button>`).join('')}</div>`:''}
  ${!list.length?`<div class="ph">${Z.t(all.length&&mode==='search'?'nores':'novid')}</div>`
    :mode==='shorts'?`<div class="reels">${list.map(v=>reel(v,me)).join('')}</div>`
    :list.map(v=>card(v,me)).join('')}`;

  /* load video files from IndexedDB */
  el.querySelectorAll('video[data-id]').forEach(async vd=>{
    const b=await getBlob(vd.dataset.id).catch(()=>null);if(!b)return;
    const u=URL.createObjectURL(b);urls.push(u);
    vd.onplay=()=>view(vd.dataset.id);
    vd.onloadeddata=()=>{const s=vd.closest('.rl');
      if(s&&s.dataset.vis==='1')vd.play().catch(()=>{vd.muted=true;vd.play().catch(()=>{})})};
    vd.src=u;
  });

  /* autoplay the visible short, pause the others */
  const rc=el.querySelector('.reels');
  if(rc){
    io=new IntersectionObserver(es=>es.forEach(e=>{
      const vd=e.target.querySelector('video'),on=e.isIntersecting&&e.intersectionRatio>=.7;
      e.target.dataset.vis=on?'1':'0';
      if(on){const p=vd.play();if(p)p.catch(()=>{vd.muted=true;vd.play().catch(()=>{})})}else vd.pause();
    }),{root:rc,threshold:[0,.7]});
    rc.querySelectorAll('.rl').forEach(s=>io.observe(s));
    rc.onclick=e=>{if(e.target.tagName==='VIDEO'){const vd=e.target;vd.paused?vd.play():vd.pause()}};
  }

  const qi=$('w-q');
  if(qi)qi.oninput=()=>{q=qi.value;clearTimeout(tm);tm=setTimeout(()=>{watch(el);const n=$('w-q');if(n){n.focus();n.setSelectionRange(q.length,q.length)}},350)};

  el.onclick=async e=>{
    const b=e.target.closest('[data-a]');if(!b)return;
    const a=b.dataset.a,id=b.dataset.id;
    if(a==='mode'){mode=b.dataset.m;watch(el);return}
    if(a==='tag'){mode='search';q=b.dataset.t;watch(el);return}
    if(a==='upload'){pick(el);return}
    const all2=load(),v=all2.find(x=>x.id===id);if(!v)return;
    if(a==='like'){const k=v.likes.indexOf(me);k<0?v.likes.push(me):v.likes.splice(k,1);save(all2);upd(v,me)}
    else if(a==='share'){
      const t=v.title+' – ZENVORA',url=location.href.split('#')[0];
      if(navigator.share)navigator.share({title:'ZENVORA',text:t,url}).catch(()=>{});
      else if(navigator.clipboard)navigator.clipboard.writeText(t+' '+url);
      v.shares++;save(all2);upd(v,me);
    }
    else if(a==='cm')sheet(v.id,me);
    else if(a==='del'){await delBlob(id);save(all2.filter(x=>x.id!==id));watch(el)}
  };
}

Z.views.watch=watch;
})();
</script>
