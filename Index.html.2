const TR={
 sunrise:{n:'Sunrise ☀️',root:60,bpm:98,w:'triangle',l:'0 - 4 - 7 - 9 - 12 - 9 - 7 - 4 - 2 - 5 - 9 - 7 - 4 - 2 - 0 - -',b:'0 - - - 0 - - - 5 - - - 7 - - -',d:'k...h...k...h...'},
 neon:{n:'Neon Nights 🌃',root:57,bpm:118,w:'sawtooth',l:'0 - 3 - 7 - 10 - 7 - 3 - 0 - - - 0 - 3 - 7 - 12 - 10 - 7 - 3 - - -',b:'0 - 0 - - - 0 - 3 - 3 - - - 5 -',d:'k.h.s.h.k.h.s.hh'},
 chill:{n:'Chill Waves 🌊',root:55,bpm:76,w:'sine',l:'0 - - - 7 - - - 5 - - - 4 - - - 2 - - - 4 - - - 7 - - - 0 - - -',b:'0 - - - - - - - 5 - - - - - - -',d:'k...h.......h...'},
 dance:{n:'Dance Floor 💃',root:52,bpm:126,w:'square',l:'12 - 12 - 7 - 10 - 12 - 12 - 15 - 10 - 12 - 12 - 7 - 10 - 7 - 5 - 3 - -',b:'0 0 - 0 0 - 0 - 0 0 - 0 3 - 5 -',d:'k.hhk.hhk.hhk.hs'},
 desi:{n:'Desi Groove 🥁',root:62,bpm:104,w:'triangle',l:'0 - 1 - 4 - 5 - 7 - 5 - 4 - 1 - 0 - 4 - 7 - 8 - 7 - 5 - 4 - 1 - -',b:'0 - - - 0 - 7 - 0 - - - 5 - 7 -',d:'k..sk.s.k..sk.s.'},
 lofi:{n:'Lo-fi Rain 🌧️',root:58,bpm:82,w:'triangle',l:'0 - - 3 - - 7 - - 5 - - 3 - - - 2 - - 5 - - 9 - - 7 - - 5 - - -',b:'0 - - - - - 0 - 5 - - - - - 3 -',d:'k..hs..hk..hs.h.'}
};
let AC8=null,NB=null;
const ac=()=>{AC8=AC8||new(window.AudioContext||window.webkitAudioContext)();if(AC8.state==='suspended')AC8.resume();return AC8};
function synth(id){
  const t=TR[id],a=ac(),st=60/t.bpm/4,o=a.createGain();o.gain.value=.2;o.connect(a.destination);
  const P=s=>s.split(' ').map(x=>x==='-'?null:+x),L=P(t.l),B=P(t.b),fq=n=>440*Math.pow(2,(n-69)/12);
  const note=(n,w,d,ty,v)=>{const os=a.createOscillator(),g=a.createGain();os.type=ty;os.frequency.value=fq(n);g.gain.setValueAtTime(.0001,w);g.gain.exponentialRampToValueAtTime(v,w+.02);g.gain.exponentialRampToValueAtTime(.0001,w+d);os.connect(g);g.connect(o);os.start(w);os.stop(w+d+.05)};
  const nz=(w,d,v)=>{if(!NB){NB=a.createBuffer(1,Math.floor(a.sampleRate*.3),a.sampleRate);const x=NB.getChannelData(0);for(let i=0;i<x.length;i++)x[i]=Math.random()*2-1}
    const s=a.createBufferSource(),g=a.createGain(),f=a.createBiquadFilter();f.type='highpass';f.frequency.value=5000;s.buffer=NB;g.gain.setValueAtTime(v,w);g.gain.exponentialRampToValueAtTime(.0001,w+d);s.connect(f);f.connect(g);g.connect(o);s.start(w);s.stop(w+d+.02)};
  const kick=w=>{const os=a.createOscillator(),g=a.createGain();os.frequency.setValueAtTime(140,w);os.frequency.exponentialRampToValueAtTime(40,w+.12);g.gain.setValueAtTime(1,w);g.gain.exponentialRampToValueAtTime(.0001,w+.2);os.connect(g);g.connect(o);os.start(w);os.stop(w+.25)};
  let i=0,nx=a.currentTime+.06;
  const run=()=>{while(nx<a.currentTime+.2){const l=L[i%L.length],b=B[i%B.length],d=t.d[i%16];
    if(l!=null)note(t.root+l,nx,st*1.8,t.w,.45);if(b!=null)note(t.root-24+b,nx,st*2.2,'sine',.8);
    if(d==='k')kick(nx);else if(d==='s')nz(nx,.14,.5);else if(d==='h')nz(nx,.05,.25);nx+=st;i++}};
  run();const iv=setInterval(run,50);
  return()=>{clearInterval(iv);o.gain.setTargetAtTime(0,a.currentTime,.05);setTimeout(()=>o.disconnect(),400)};
}
const mname=m=>m.type==='synth'?(TR[m.id]||{n:'Music'}).n:(m.name||'Music');
let pl=null;
function setPP(el,on){if(!el)return;el.classList.toggle('on',on);const p=el.querySelector('.pp');if(p)p.textContent=on?'⏸':'▶'}
function stopM(){if(pl){try{pl.stop()}catch(e){}setPP(pl.el,false);pl=null}}
async function playM(m,el){
  if(pl&&el&&pl.el===el){stopM();return}
  stopM();let stop;
  if(m.type==='synth'&&TR[m.id])stop=synth(m.id);
  else if(m.type==='file'){const b=await getA(m.id);if(!b)return alert(Z.t('m_miss'));const u=URL.createObjectURL(b),au=new Audio(u);au.loop=true;au.play().catch(()=>{});stop=()=>{au.pause();URL.revokeObjectURL(u)}}
  else return;
  pl={stop,el};setPP(el,true);
}
function pickMusic(sel,cb){
  const d=modal8(`<h3 style="margin-bottom:10px">🎵 ${Z.t('m_title')}</h3><div id="ml"></div>
  <label class="pick" style="margin-top:10px">⬆ ${Z.t('m_up')}<input type="file" accept="audio/*" hidden></label><p class="sm">${Z.t('m_note')}</p>`);
  const draw=()=>{d.querySelector('#ml').innerHTML=`<div class="row4" data-m="none"><div class="av">🚫</div><div class="t"><b>${Z.t('m_none')}</b></div>${!sel?'✓':''}</div><div class="sm" style="margin:8px 0">${Z.t('m_lib')}</div>`+
    Object.keys(TR).map(k=>`<div class="row4" data-m="${k}"><div class="av">🎵</div><div class="t"><b>${TR[k].n}</b></div><button class="mini bl" data-p="${k}"><i class="pp">▶</i></button>${sel&&sel.type==='synth'&&sel.id===k?'✓':''}</div>`).join('')+
    (sel&&sel.type==='file'?`<div class="row4" data-m="keep"><div class="av">🎧</div><div class="t"><b>${esc(sel.name)}</b></div>✓</div>`:'')};
  draw();
  d.addEventListener('click',e=>{
    if(e.target===d){stopM();return}
    const p=e.target.closest('[data-p]');if(p){playM({type:'synth',id:p.dataset.p},p);return}
    const r=e.target.closest('[data-m]');if(!r)return;
    const k=r.dataset.m;stopM();d.remove();
    cb(k==='none'?null:k==='keep'?sel:{type:'synth',id:k});
  });
  d.querySelector('input').onchange=async e=>{
    const f=e.target.files[0];if(!f)return;
    if(f.size>8*1048576)return alert(Z.t('m_big'));
    if(!confirm(Z.t('m_rights')))return;
    const id='a'+Date.now();try{await putA(id,f)}catch(x){return alert(Z.t('m_big'))}
    stopM();d.remove();cb({type:'file',id,name:f.name.replace(/\.[^.]+$/,'').slice(0,40)});
  };
}

