function reportsV(){
  if(!isAdmin())return;
  const R=ld('zv_reports').filter(r=>r.status==='open').sort((a,b)=>b.ts-a.ts),sus=users().filter(u=>u.suspended);
  const tl={post:'📝',video:'🎬',user:'👤'};
  const d=overlay10('rpv',head('🚩 '+Z.t('x_reports')+' ('+R.length+')')+
  (R.map(r=>`<div class="card"><b>${tl[r.type]||''} ${Z.t('x_r_'+r.reason)}</b><div class="sm">@${esc(r.ownerName)} · ${esc(r.preview)} · ${Z.t('x_by')} @${esc(r.byName)}</div>
  ${r.note?`<p style="font-size:13px;margin:6px 0">${esc(r.note)}</p>`:''}
  <div class="ab">${r.type!=='user'?`<button class="btn sec" data-r="rm" data-id="${r.id}">🗑 ${Z.t('x_rm')}</button>`:''}<button class="btn sec" data-r="lock" data-id="${r.id}">🔒 ${Z.t('x_susp1')}</button><button class="btn sec" data-r="no" data-id="${r.id}">${Z.t('x_dismiss')}</button></div></div>`).join('')||`<div class="ph">${Z.t('x_norep')}</div>`)+
  (sus.length?`<h4 style="margin:14px 0 8px">${Z.t('x_lockedacc')}</h4>`+sus.map(u=>`<div class="row4" style="cursor:default"><div class="av">${esc(u.name[0].toUpperCase())}</div><div class="t"><b>${esc(u.name)}</b></div><button class="mini ok" data-r="un" data-u="${u.id}">${Z.t('x_unlk')}</button></div>`).join(''):''));
  d.onclick=e=>{
    if(e.target.closest('[data-k="x"]')){d.remove();return}
    const b=e.target.closest('[data-r]');if(!b)return;const a=b.dataset.r;
    if(a==='un'){patchUser(b.dataset.u,x=>{delete x.suspended});alert(Z.t('x_unlk'));return reportsV()}
    const R2=ld('zv_reports'),r=R2.find(x=>x.id===b.dataset.id);if(!r)return;
    if(a==='rm'){
      if(r.type==='post')sv('zv_posts',ld('zv_posts').filter(p=>p.id!==r.target));
      else if(r.type==='video'){sv('zv_videos',ld('zv_videos').filter(x=>x.id!==r.target));delBlob(r.target)}
      R2.forEach(x=>{if(x.type===r.type&&x.target===r.target)x.status='actioned'});alert(Z.t('x_removed'));
    }else if(a==='lock'){
      if(r.owner&&r.owner!==users()[0].id){patchUser(r.owner,x=>x.suspended=true);R2.forEach(x=>{if(x.owner===r.owner)x.status='actioned'});alert(Z.t('x_userlocked'))}
    }else r.status='dismissed';
    sv('zv_reports',R2);reportsV();
  };
}

/* ================= 6) WIRING INTO EXISTING SCREENS ================= */
function decorate(){
  if(!Z.user)return;
  const v=$('view');
  if(v.querySelector('article.post:not([data-x10]),article.vc:not([data-x10]),.rl:not([data-x10]),.st[data-s]:not([data-x10])')){
    const P={},V={},S={};
    ld('zv_posts').forEach(p=>P[p.id]=p);ld('zv_videos').forEach(x=>V[x.id]=x);ld('zv_stories').forEach(s=>S[s.id]=s);
    v.querySelectorAll('article.post:not([data-x10])').forEach(a=>{a.dataset.x10=1;const p=P[a.dataset.id];if(!p)return;
      if(!allowed(p.uid)){a.remove();return}
      if(p.uid!==me()&&p.uid!=='official')a.querySelector('.pt-head').appendChild(mkMore(()=>menu('post',p.id,p.uid,p.text||'📷')))});
    v.querySelectorAll('article.vc:not([data-x10]),.rl:not([data-x10])').forEach(a=>{a.dataset.x10=1;
      const vd=a.querySelector('video'),x=V[(vd&&vd.dataset.id)||a.dataset.id];if(!x)return;
      if(!allowed(x.uid)){a.remove();return}
      if(x.uid!==me()){const host=a.querySelector('.r')||a.querySelector('.side');if(host)host.appendChild(mkMore(()=>menu('video',x.id,x.uid,x.title)))}});
    v.querySelectorAll('.st[data-s]:not([data-x10])').forEach(a=>{a.dataset.x10=1;const s=S[a.dataset.s];if(s&&!allowed(s.uid))a.remove()});
  }
  const g=v.querySelector('#s6c .p5-grid');
  if(g&&g.querySelector('[data-a="go"]')&&!g.querySelector('[data-x10t]')){
    const T=[['lock','🔒',Z.t('x_lock'),lockV],['blk','🚫',Z.t('x_blocked'),blockedV],['legal','📜',Z.t('x_legal'),()=>legal('terms')]];
    if(isAdmin())T.push(['rep','🚩',Z.t('x_reports'),reportsV]);
    T.forEach(([k,i,l,f])=>{const b=document.createElement('button');b.className='tile';b.dataset.x10t=k;b.innerHTML=`<span>${i}</span>${l}`;b.onclick=f;g.appendChild(b)});
  }
}
new MutationObserver(decorate).observe($('view'),{childList:true,subtree:true});

new MutationObserver(ms=>ms.forEach(m=>m.addedNodes.forEach(n=>{
  if(!n.id||!Z.user)return;
  if(n.id==='db'&&FREE){
    n.querySelectorAll('[data-d="buy"],[data-d="vip"],[data-d="wd"]').forEach(b=>{b.classList.add('soon');b.textContent='🔜 '+Z.t('x_soon')});
    const f=document.createElement('div');f.className='fm';f.textContent='🚀 '+Z.t('x_free');
    const w=n.querySelector('.wbar');if(w)w.after(f);
  }else if(n.id==='fp'){
    n.querySelectorAll('.row4[data-y="op"]').forEach(r=>{if(blockedEither(r.dataset.id))r.remove()});
  }else if(n.id==='op'){
    const oh=n.querySelector('.oh'),nm=n.querySelector('.pf-name');
    if(oh&&nm&&nm.firstChild){
      const name=nm.firstChild.nodeValue,m=users().filter(u=>u.name===name&&u.id!==me());
      if(m.length===1){const o=m[0];
        if(blockedEither(o.id)){n.remove();return}
        oh.appendChild(mkMore(()=>menu('user',o.id,o.id,o.name)))}
    }
  }
}))).observe(document.body,{childList:true});

/* ================= 7) LOOP: lock screen, suspension, consent ================= */
function tick(){
  syncAgree();
  if(!Z.user){const l=$('lk');if(l)l.remove();return}
  if(cur().suspended&&!isAdmin()){alert(Z.t('x_susp'));Z.logout();return}
  maybeLock();consent();
}
setInterval(tick,1500);tick();
})();
</script>
</body>
