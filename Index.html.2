.ovc{height:132px;border-radius:22px;margin-bottom:-46px}
.cvb{position:absolute;top:10px;left:10px;background:rgba(0,0,0,.35);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:0;border-radius:50%;width:40px;height:40px;font-size:17px;cursor:pointer;color:#fff}
</style>

<script>
(function(){
const $=Z.$;
Object.assign(Z.T.en,{n_t:'Notifications',n_none:'No notifications yet.',n_clr:'Clear',n_fr:'sent you a friend request',n_fa:'accepted your friend request',n_lp:'liked your post',n_lv:'liked your video',n_cm:'commented:',n_gf:'sent you a gift',n_va:'Your identity verification was approved ✔',n_vr:'Your identity verification was rejected.',n_wp:'Your withdrawal was paid.',n_wr:'Your withdrawal was rejected and the coins were refunded.',n_new:'new notifications',
f_t:'Friends',f_pp:'People',f_rq:'Requests',f_srch:'Search people…',f_add:'Add friend',f_req:'Requested',f_acc:'Accept',f_is:'Friends ✓',f_unc:'Remove this friend?',f_none:'Nobody here yet.',f_alone:'No other accounts on this device yet. Add another account from Settings → Accounts to try friend requests.',f_msg:'Message',f_priv:'This account is private. Become friends to see their posts.',f_sent:'Friend request sent.',f_ok:'You are now friends!',f_cov:'Cover photo',f_covr:'Remove cover photo',
a_t:'Accounts',a_add:'Add another account',a_cur:'Current',a_cont:'Continue as',a_fg:'Remove this account from this device?',a_hint:'Log in or sign up with another account.',a_sw:'Switching account…'});
Object.assign(Z.T.bn,{n_t:'নোটিফিকেশন',n_none:'এখনো কোনো নোটিফিকেশন নেই।',n_clr:'মুছুন',n_fr:'আপনাকে ফ্রেন্ড রিকোয়েস্ট পাঠিয়েছেন',n_fa:'আপনার ফ্রেন্ড রিকোয়েস্ট গ্রহণ করেছেন',n_lp:'আপনার পোস্টে লাইক দিয়েছেন',n_lv:'আপনার ভিডিওতে লাইক দিয়েছেন',n_cm:'কমেন্ট করেছেন:',n_gf:'আপনাকে গিফট পাঠিয়েছেন',n_va:'আপনার আইডেন্টিটি ভেরিফিকেশন অনুমোদিত হয়েছে ✔',n_vr:'আপনার আইডেন্টিটি ভেরিফিকেশন বাতিল হয়েছে।',n_wp:'আপনার উত্তোলনের টাকা পাঠানো হয়েছে।',n_wr:'উত্তোলন বাতিল হয়েছে, কয়েন ফেরত দেওয়া হয়েছে।',n_new:'টি নতুন নোটিফিকেশন',
f_t:'ফ্রেন্ডস',f_pp:'মানুষ',f_rq:'রিকোয়েস্ট',f_srch:'মানুষ খুঁজুন…',f_add:'ফ্রেন্ড করুন',f_req:'পাঠানো হয়েছে',f_acc:'গ্রহণ',f_is:'ফ্রেন্ড ✓',f_unc:'এই ফ্রেন্ডকে সরাবেন?',f_none:'এখানে এখনো কেউ নেই।',f_alone:'এই ডিভাইসে আর কোনো অ্যাকাউন্ট নেই। ফ্রেন্ড রিকোয়েস্ট চেষ্টা করতে Settings → Accounts থেকে আরেকটি অ্যাকাউন্ট যোগ করুন।',f_msg:'মেসেজ',f_priv:'এটি প্রাইভেট অ্যাকাউন্ট। পোস্ট দেখতে ফ্রেন্ড হোন।',f_sent:'ফ্রেন্ড রিকোয়েস্ট পাঠানো হয়েছে।',f_ok:'এখন আপনারা ফ্রেন্ড!',f_cov:'কভার ফটো',f_covr:'কভার ফটো সরান',
a_t:'অ্যাকাউন্টস',a_add:'আরেকটি অ্যাকাউন্ট যোগ করুন',a_cur:'চলমান',a_cont:'এভাবে চালিয়ে যান',a_fg:'এই অ্যাকাউন্ট এই ডিভাইস থেকে সরাবেন?',a_hint:'আরেকটি অ্যাকাউন্টে লগ ইন বা সাইন আপ করুন।',a_sw:'অ্যাকাউন্ট বদলানো হচ্ছে…'});

const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ld=(k,d=[])=>{try{const v=JSON.parse(localStorage[k]);return v==null?d:v}catch(e){return d}};
const sv=(k,v)=>{try{localStorage[k]=JSON.stringify(v);return true}catch(e){alert(Z.t('full'));return false}};
const ago=ts=>{const m=Math.floor((Date.now()-ts)/6e4);return m<1?Z.t('now'):m<60?m+'m':m<1440?Math.floor(m/60)+'h':Math.floor(m/1440)+'d'};
const fmt=n=>n>=1e6?(n/1e6).toFixed(1)+'M':n>=1e3?(n/1e3).toFixed(1)+'K':n;
const COVERS=['linear-gradient(135deg,#1e5bff,#8a2be2)','linear-gradient(135deg,#ff2d75,#8a2be2)','linear-gradient(135deg,#00c6ff,#1e5bff)','linear-gradient(135deg,#f7b500,#ff2d75)','linear-gradient(135deg,#0a1a5c,#8a2be2)'];
const users=()=>ld('zv_users');
const cur=()=>users().find(u=>u.id===Z.user.id)||Z.user;
const uname=id=>(users().find(u=>u.id===id)||{}).name||'User';
const avh=u=>u.avatar?`<img src="${u.avatar}" alt="" style="width:100%;height:100%;object-fit:cover">`:esc(((u.name||'?')[0]||'?').toUpperCase());
const bd=u=>u.verified==='vip_pro'?'<span class="bdg vip">👑 PRO</span>':u.verified==='identity'?'<span class="bdg id">✔</span>':'';
const coverCss=u=>u.coverImg?`url('${u.coverImg}') center/cover`:COVERS[u.cover||0];
function patch(fn){const L=users(),u=L.find(x=>x.id===Z.user.id);if(!u)return false;fn(u);if(!sv('zv_users',L))return false;Object.assign(Z.user,u);return true}
function toCover(f){return new Promise(res=>{const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const W=900,H=300,s=Math.max(W/im.width,H/im.height),c=document.createElement('canvas');c.width=W;c.height=H;c.getContext('2d').drawImage(im,(W-im.width*s)/2,(H-im.height*s)/2,im.width*s,im.height*s);res(c.toDataURL('image/jpeg',.78))};im.src=r.result};r.readAsDataURL(f)})}
const getBlob=id=>new Promise(res=>{const r=indexedDB.open('zv_videos',1);r.onupgradeneeded=()=>r.result.createObjectStore('v');r.onsuccess=()=>{try{const q=r.result.transaction('v').objectStore('v').get(id);q.onsuccess=()=>res(q.result);q.onerror=()=>res(null)}catch(e){res(null)}};r.onerror=()=>res(null)});
function modal7(html){const d=document.createElement('div');d.className='m4';d.innerHTML=`<div class="m4b">${html}</div>`;d.addEventListener('click',e=>{if(e.target===d)d.remove()});document.body.appendChild(d);return d}
function overlay(id,html){const o=$(id);if(o)o.remove();const d=document.createElement('div');d.id=id;d.className='ov7';d.innerHTML=html;document.body.appendChild(d);return d}
const closeOv=id=>{const o=$(id);if(o)o.remove()};

/* ================= FRIENDS ================= */
const FR=()=>ld('zv_fr');
const relOf=(me,o)=>{const f=FR().find(x=>(x.a===me&&x.b===o)||(x.a===o&&x.b===me));return !f?'none':f.status==='accepted'?'friends':f.a===me?'sent':'recv'};
const friendIds=me=>FR().filter(f=>f.status==='accepted'&&(f.a===me||f.b===me)).map(f=>f.a===me?f.b:f.a);
function pushN(to,type,extra){const L=ld('zv_notif');L.push({id:'n'+Date.now()+Math.random().toString(36).slice(2,5),to,type,from:Z.user.id,name:Z.user.name,extra,ts:Date.now(),read:false});sv('zv_notif',L.slice(-300))}
function act(t,o){
  const me=Z.user.id,same=f=>(f.a===me&&f.b===o)||(f.a===o&&f.b===me);let F=FR();
  if(t==='add'){const rv=F.find(f=>f.a===o&&f.b===me&&f.status==='pending');
    if(rv){rv.status='accepted';pushN(o,'fa');alert(Z.t('f_ok'))}
    else if(!F.some(same)){F.push({id:'f'+Date.now(),a:me,b:o,status:'pending',ts:Date.now()});pushN(o,'fr');alert(Z.t('f_sent'))}}
  else if(t==='acc'){const f=F.find(f=>f.a===o&&f.b===me&&f.status==='pending');if(f){f.status='accepted';pushN(o,'fa');alert(Z.t('f_ok'))}}
  else if(t==='dec')F=F.filter(f=>!(f.a===o&&f.b===me&&f.status==='pending'));
  else if(t==='cancel'){F=F.filter(f=>!(f.a===me&&f.b===o&&f.status==='pending'));sv('zv_notif',ld('zv_notif').filter(n=>!(n.type==='fr'&&n.from===me&&n.to===o)))}
  else if(t==='unf')F=F.filter(f=>!(same(f)&&f.status==='accepted'));
  sv('zv_fr',F);badges();
}

let ftab='people',fq='';
function friendsV(tab){
  ftab=tab||ftab;
  const me=Z.user.id,F=FR(),all=users(),U=id=>all.find(u=>u.id===id);
  const inc=F.filter(f=>f.b===me&&f.status==='pending'&&U(f.a)),out=F.filter(f=>f.a===me&&f.status==='pending'&&U(f.b)),fl=friendIds(me).filter(U);
  const urow=u=>{const r=relOf(me,u.id);let b='';
    if(r==='none')b=`<button class="mini bl" data-y="add" data-id="${u.id}">＋ ${Z.t('f_add')}</button>`;
    else if(r==='sent')b=`<button class="mini gr" data-y="cancel" data-id="${u.id}">${Z.t('f_req')} ✕</button>`;
    else if(r==='recv')b=`<button class="mini ok" data-y="acc" data-id="${u.id}">✔ ${Z.t('f_acc')}</button><button class="mini no" data-y="dec" data-id="${u.id}">✕</button>`;
    else b=`<span class="sm">${Z.t('f_is')}</span>`;
    return `<div class="row4" data-y="op" data-id="${u.id}"><div class="av">${avh(u)}</div><div class="t"><b>${esc(u.name)}${bd(u)}</b><div>${esc(u.bio||'')}</div></div>${b}</div>`};
  const others=all.filter(u=>u.id!==me);
  const plist=()=>{const q=fq.trim().toLowerCase(),L=others.filter(u=>u.name.toLowerCase().includes(q));return L.map(urow).join('')||`<div class="ph">${Z.t(others.length?'f_none':'f_alone')}</div>`};
  const T=(k,l,n)=>`<button class="${ftab===k?'on':''}" data-y="ft" data-t="${k}">${l}${n!=null?' · '+n:''}</button>`;
  let body;
  if(ftab==='people')body=`<input class="inp" id="fq" value="${esc(fq)}" placeholder="${Z.t('f_srch')}"><div id="fl">${plist()}</div>`;
  else if(ftab==='req')body=(inc.map(f=>urow(U(f.a))).join('')+out.map(f=>urow(U(f.b))).join(''))||`<div class="ph">${Z.t('f_none')}</div>`;
  else body=fl.map(id=>urow(U(id))).join('')||`<div class="ph">${Z.t('f_none')}</div>`;
  const d=overlay('fp',`<div class="oh"><button class="ic" data-y="x">←</button><b style="flex:1;font-size:18px">👥 ${Z.t('f_t')}</b></div>
  <div class="pf-tabs">${T('people',Z.t('f_pp'))}${T('req',Z.t('f_rq'),inc.length)}${T('list',Z.t('f_t'),fl.length)}</div>${body}`);
  const qi=d.querySelector('#fq');if(qi)qi.oninput=()=>{fq=qi.value;d.querySelector('#fl').innerHTML=plist()};
  d.onclick=e=>{
    const b=e.target.closest('[data-y]');if(!b)return;const y=b.dataset.y,id=b.dataset.id;
    if(y==='x')closeOv('fp');
    else if(y==='ft')friendsV(b.dataset.t);
    else if(y==='op')openProfile(id);
    else if(['add','cancel','acc','dec'].includes(y)){act(y,id);friendsV()}
  };
}

/* ================= OTHER USER'S PROFILE ================= */
let purls=[];
function gotoChat(id){
  Z.tab='chat';renderNav();render();
  const v=$('view'),q=s=>v.querySelector(s);
  if(q('[data-a=back]'))q('[data-a=back]').click();
  const c=q('[data-a=sec][data-s=chats]');if(c&&!c.classList.contains('on'))c.click();
  const r=q('.row4[data-a=open][data-id="'+id+'"]');if(r)r.click();
}
function openProfile(uid,tab='posts'){
  const me=Z.user.id;
  if(uid===me){closeOv('fp');closeOv('np');closeOv('op');Z.tab='profile';renderNav();render();return}
  const u=users().find(x=>x.id===uid);if(!u)return;
  purls.forEach(x=>URL.revokeObjectURL(x));purls=[];
  const rel=relOf(me,uid),posts=ld('zv_posts').filter(p=>p.uid===uid).sort((a,b)=>b.ts-a.ts),vids=ld('zv_videos').filter(v=>v.uid===uid).sort((a,b)=>b.ts-a.ts);
  const locked=u.private&&rel!=='friends';
  const fa={none:`<button class="btn" data-y="add">＋ ${Z.t('f_add')}</button>`,sent:`<button class="btn sec" data-y="cancel">⏳ ${Z.t('f_req')}</button>`,
    recv:`<button class="btn" data-y="acc">✔ ${Z.t('f_acc')}</button><button class="btn sec" data-y="dec">✕</button>`,friends:`<button class="btn sec" data-y="unf">${Z.t('f_is')}</button>`}[rel];
  const T=(k,l,n)=>`<button class="${tab===k?'on':''}" data-y="tab" data-t="${k}">${l} · ${n}</button>`;
  let body;
  if(locked)body=`<div class="ph">🔒<br>${Z.t('f_priv')}</div>`;
  else if(tab==='posts')body=posts.length?`<div class="gd">${posts.map(p=>`<div data-y="post" data-id="${p.id}">${p.img?`<img src="${p.img}" alt="">`:`<div class="tx">${esc((p.text||'').slice(0,90))}</div>`}<div class="ov">❤️ ${p.likes.length} · 💬 ${p.comments.length}</div></div>`).join('')}</div>`:`<div class="ph">${Z.t('s6_nop')}</div>`;
  else body=vids.length?`<div class="gd">${vids.map(v=>`<div data-y="vid" data-id="${v.id}"><video muted playsinline preload="metadata" data-v="${v.id}"></video><div class="ov">▶ ${fmt(v.views)} · ❤️ ${v.likes.length}</div></div>`).join('')}</div>`:`<div class="ph">${Z.t('s6_nov')}</div>`;
  const d=overlay('op',`<div class="oh"><button class="ic" data-y="x">←</button></div>
  <div class="ovc" style="background:${coverCss(u)}"></div>
  <div class="pf-top"><div class="pf-av">${avh(u)}</div></div>
  <div class="pf-name">${esc(u.name)}${bd(u)}</div>
  ${u.bio?`<div class="pf-bio">${esc(u.bio)}</div>`:''}
  <div class="ab">${fa}<button class="btn sec" data-y="msg">💬 ${Z.t('f_msg')}</button></div>
  <div class="pf-st"><div><b>${posts.length}</b>${Z.t('s6_posts')}</div><div><b>${vids.length}</b>${Z.t('s6_vid')}</div><div><b>${friendIds(uid).length}</b>${Z.t('f_t')}</div></div>
  ${locked?'':`<div class="pf-tabs">${T('posts','▦ '+Z.t('s6_posts'),posts.length)}${T('videos','▶ '+Z.t('s6_vid'),vids.length)}</div>`}${body}`);
  d.querySelectorAll('video[data-v]').forEach(async v=>{const b=await getBlob(v.dataset.v);if(!b)return;const url=URL.createObjectURL(b);purls.push(url);v.src=url+'#t=0.1'});
  d.onclick=async e=>{
    const b=e.target.closest('[data-y]');if(!b)return;const y=b.dataset.y,id=b.dataset.id;
    if(y==='x'){purls.forEach(x=>URL.revokeObjectURL(x));closeOv('op');if($('fp'))friendsV()}
    else if(y==='tab')openProfile(uid,b.dataset.t);
    else if(['add','cancel','acc','dec'].includes(y)){act(y,uid);openProfile(uid,tab)}
    else if(y==='unf'){if(confirm(Z.t('f_unc'))){act('unf',uid);openProfile(uid,tab)}}
    else if(y==='msg'){
      const cid='dm_'+[me,uid].sort().join('_'),L=ld('zv_chats');
      if(!L.find(c=>c.id===cid)){L.push({id:cid,type:'dm',members:[me,uid],msgs:[],ts:Date.now()});sv('zv_chats',L)}
      closeOv('op');closeOv('fp');closeOv('np');gotoChat(cid)}
    else if(y==='post'){const p=posts.find(x=>x.id===id);if(!p)return;
      modal7(`<b>${esc(p.cat)} · ${ago(p.ts)}</b>${p.img?`<img src="${p.img}" style="width:100%;border-radius:14px;margin:10px 0" alt="">`:''}${p.text?`<p style="white-space:pre-wrap;word-break:break-word;line-height:1.5;margin:10px 0">${esc(p.text)}</p>`:''}<p class="sm">❤️ ${p.likes.length} · 💬 ${p.comments.length} · ↗️ ${p.shares}</p>`)}
    else if(y==='vid'){const v=vids.find(x=>x.id===id),bl=await getBlob(id);if(!v)return;
      const m=modal7(`<b>${esc(v.title)}</b><video controls autoplay playsinline style="width:100%;border-radius:14px;background:#000;max-height:60vh;margin-top:10px"></video><p class="sm" style="margin-top:8px">👁 ${fmt(v.views)} · ❤️ ${v.likes.length}</p>`);
      if(bl){const url=URL.createObjectURL(bl);m.querySelector('video').src=url;m.addEventListener('click',()=>URL.revokeObjectURL(url))}}
  };
}

/* ================= NOTIFICATIONS ================= */
const ICO={fr:'👥',fa:'✅',like:'❤️',cm:'💬',gift:'🎁',ver:'✅',wd:'💸'};
function ntext(n){
  const nm=`<b>${esc(n.name||uname(n.from))}</b>`;
  switch(n.type){
    case'fr':return nm+' '+Z.t('n_fr');case'fa':return nm+' '+Z.t('n_fa');
    case'like':return nm+' '+Z.t(n.extra==='video'?'n_lv':'n_lp');
    case'cm':return nm+' '+Z.t('n_cm')+' “'+esc(n.extra)+'”';
    case'gift':return nm+' '+Z.t('n_gf')+' (+'+esc(n.extra)+' 🪙)';
    case'ver':return Z.t(n.extra==='approved'?'n_va':'n_vr');
    case'wd':return Z.t(n.extra==='paid'?'n_wp':'n_wr');
  }return '';
}
function notifV(){
  const me=Z.user.id,L=ld('zv_notif').filter(n=>n.to===me).sort((a,b)=>b.ts-a.ts).slice(0,80);
  const d=overlay('np',`<div class="oh"><button class="ic" data-y="x">←</button><b style="flex:1;font-size:18px">🔔 ${Z.t('n_t')}</b>${L.length?`<button class="chip on" data-y="clr">${Z.t('n_clr')}</button>`:''}</div>`+
  (L.map(n=>`<div class="nt ${n.read?'':'un'}" data-y="n" data-id="${n.id}"><div class="ico">${ICO[n.type]||'🔔'}</div><div style="flex:1;min-width:0;word-break:break-word">${ntext(n)}<div class="sm">${ago(n.ts)}</div></div></div>`).join('')||`<div class="ph">${Z.t('n_none')}</div>`));
  const all=ld('zv_notif');all.forEach(n=>{if(n.to===me)n.read=true});sv('zv_notif',all);badges();
  d.onclick=e=>{
    const b=e.target.closest('[data-y]');if(!b)return;
    if(b.dataset.y==='x')closeOv('np');
    else if(b.dataset.y==='clr'){sv('zv_notif',ld('zv_notif').filter(n=>n.to!==me));notifV()}
    else if(b.dataset.y==='n'){const n=L.find(x=>x.id===b.dataset.id);if(!n||!n.from)return;
      if(n.type==='fr'){closeOv('np');friendsV('req')}else openProfile(n.from)}
  };
}

/* detect likes / comments / gifts / verification / withdrawal changes for the logged-in user */
function scan(){
  const me=Z.user.id,S=ld('zv_snap',{}),posts=ld('zv_posts').filter(p=>p.uid===me),vids=ld('zv_videos').filter(v=>v.uid===me),
    tx=ld('zv_tx').filter(t=>t.uid===me),src={},now={l:{},c:{},t:tx.reduce((m,t)=>Math.max(m,t.ts),0),s:{}};
  posts.forEach(p=>{src['p'+p.id]=p;now.l['p'+p.id]=p.likes;now.c['p'+p.id]=p.comments.length});
  vids.forEach(v=>{src['v'+v.id]=v;now.l['v'+v.id]=v.likes;now.c['v'+v.id]=v.comments.length});
  ld('zv_vreq').concat(ld('zv_wd')).filter(r=>r.uid===me).forEach(r=>now.s[r.id]=r.status);
  const o=S[me];
  if(o){
    const out=[],mk=(type,from,name,extra)=>out.push({id:'n'+Date.now()+Math.random().toString(36).slice(2,6),to:me,type,from,name,extra,ts:Date.now(),read:false});
    for(const k in now.l){const it=src[k],ol=o.l[k]||[],kind=k[0]==='p'?'post':'video';
      now.l[k].filter(x=>x!==me&&!ol.includes(x)).forEach(x=>mk('like',x,uname(x),kind));
      it.comments.slice(o.c[k]||0).filter(c=>c.uid!==me).forEach(c=>mk('cm',c.uid,c.name,String(c.text).slice(0,60)))}
    tx.filter(t=>t.ts>o.t&&String(t.text).startsWith('🎁 ←')).forEach(t=>mk('gift',null,String(t.text).replace('🎁 ← @',''),t.coins));
    for(const k in now.s)if(o.s[k]&&o.s[k]!==now.s[k])mk(k.startsWith('vr')?'ver':'wd',null,'',now.s[k]);
    if(out.length)sv('zv_notif',ld('zv_notif').concat(out).slice(-300));
  }
  if(!o||JSON.stringify(o)!==JSON.stringify(now)){S[me]=now;sv('zv_snap',S)}
}

/* ================= HEADER BUTTONS + BADGES ================= */
const hdr=document.querySelector('header');
const mk=(ic,id)=>{const b=document.createElement('button');b.className='ic';b.id=id;b.innerHTML=ic+'<i class="bg7"></i>';return b};
const bell=mk('🔔','b-bell'),fb=mk('👥','b-fr');
hdr.insertBefore(bell,$('b-theme'));hdr.insertBefore(fb,$('b-theme'));
bell.onclick=()=>notifV();fb.onclick=()=>{closeOv('op');friendsV('people')};
const setB=(b,n)=>{const i=b.querySelector('.bg7');i.textContent=n>9?'9+':n;i.style.display=n?'flex':'none'};
let seenU=0,seenId=null;
function badges(){
  if(!Z.user)return;const me=Z.user.id;
  const un=ld('zv_notif').filter(n=>n.to===me&&!n.read).length,rq=FR().filter(f=>f.b===me&&f.status==='pending').length;
  setB(bell,un);setB(fb,rq);
  if(seenId!==me){seenId=me;seenU=0;if(un>0)alert('🔔 '+un+' '+Z.t('n_new'))}
  else if(un>seenU)alert('🔔 '+un+' '+Z.t('n_new'));
  seenU=un;
}

/* ================= MULTI-ACCOUNT ================= */
function remember(){if(!Z.user)return;const a=ld('zv_accts');if(!a.includes(Z.user.id)){a.push(Z.user.id);sv('zv_accts',a)}}
function switchTo(id){if(!users().some(u=>u.id===id))return;localStorage.zv_session=id;location.reload()}
const saved=()=>{const us=users();return ld('zv_accts').filter(id=>us.some(u=>u.id===id))};
function accBox(){
  const us=users(),me=Z.user.id,d=document.createElement('div');d.className='card acc-box';
  d.innerHTML=`<h4>👤 ${Z.t('a_t')}</h4>`+saved().map(id=>{const u=us.find(x=>x.id===id);
    return `<div class="row4" data-y="sw" data-id="${id}"><div class="av">${avh(u)}</div><div class="t"><b>${esc(u.name)}</b><div>${esc(u.email)}</div></div>${id===me?`<span class="bdg id">${Z.t('a_cur')}</span>`:`<button class="mini no" data-y="fg" data-id="${id}">✕</button>`}</div>`}).join('')+
    `<button class="btn" style="margin-top:6px" data-y="addacc">＋ ${Z.t('a_add')}</button>`;
  d.onclick=e=>{
    const b=e.target.closest('[data-y]');if(!b)return;const y=b.dataset.y,id=b.dataset.id;
    if(y==='fg'){if(confirm(Z.t('a_fg'))){sv('zv_accts',ld('zv_accts').filter(x=>x!==id));d.replaceWith(accBox())}}
    else if(y==='sw'&&id!==me){alert(Z.t('a_sw'));switchTo(id)}
    else if(y==='addacc'){Z.logout();alert(Z.t('a_hint'))}
  };
  return d;
}
/* saved accounts on the login screen */
const al=document.createElement('div');al.id='acc-list';$('auth').insertBefore(al,$('a-lang'));
let asig='';
function renderAccList(){
  const ids=saved(),sig=ids.join()+Z.lang;if(sig===asig)return;asig=sig;
  const us=users();
  al.innerHTML=ids.length?`<div class="sm" style="margin:16px 0 8px">${Z.t('a_cont')}</div>`+ids.map(id=>{const u=us.find(x=>x.id===id);
    return `<div class="row4" data-y="sw" data-id="${id}" style="text-align:left"><div class="av">${avh(u)}</div><div class="t"><b>${esc(u.name)}</b><div>${esc(u.email)}</div></div><button class="mini no" data-y="fg" data-id="${id}">✕</button></div>`}).join(''):'';
}
al.onclick=e=>{
  const b=e.target.closest('[data-y]');if(!b)return;const id=b.dataset.id;
  if(b.dataset.y==='fg'){if(confirm(Z.t('a_fg'))){sv('zv_accts',ld('zv_accts').filter(x=>x!==id));asig='';renderAccList()}}
  else switchTo(id);
};

/* ================= DECORATE Part 5/6 screens ================= */
function decorate(){
  if(!Z.user)return;const v=$('view'),u=cur();
  /* own profile: cover photo + friends stat */
  const cv=v.querySelector('.pf-cover');
  if(cv&&!cv.dataset.d){cv.dataset.d=1;cv.style.background=coverCss(u);
    const up=document.createElement('button');up.className='cvb';up.title=Z.t('f_cov');up.textContent='📷';
    up.onclick=()=>{const i=document.createElement('input');i.type='file';i.accept='image/*';
      i.onchange=async()=>{if(!i.files[0])return;const img=await toCover(i.files[0]);if(patch(x=>x.coverImg=img)){cv.style.background=coverCss(cur());decorate2(cv)}};i.click()};
    cv.appendChild(up);decorate2(cv);
  }
  const st=v.querySelector('.pf-st');
  if(st&&!st.dataset.d&&v.querySelector('.pf-cover')){st.dataset.d=1;
    const f=document.createElement('div');f.style.cursor='pointer';f.innerHTML=`<b>${friendIds(u.id).length}</b>${Z.t('f_t')}`;f.onclick=()=>friendsV('list');st.appendChild(f)}
  /* settings hub: accounts */
  const lo=v.querySelector('#s6c [data-a="logout"]');
  if(lo&&!v.querySelector('.acc-box'))lo.insertAdjacentElement('beforebegin',accBox());
  /* feed: profile photos */
  v.querySelectorAll('article.post:not([data-av])').forEach(a=>{a.dataset.av=1;
    const p=ld('zv_posts').find(x=>x.id===a.dataset.id),o=p&&users().find(x=>x.id===p.uid),av=a.querySelector('.pt-head .av');
    if(o&&o.avatar&&av)av.innerHTML=avh(o)});
}
function decorate2(cv){  /* remove-cover button */
  const old=cv.querySelector('.cvr');if(old)old.remove();
  if(!cur().coverImg)return;
  const r=document.createElement('button');r.className='cvb cvr';r.style.left='56px';r.title=Z.t('f_covr');r.textContent='✕';
  r.onclick=()=>{if(patch(x=>{delete x.coverImg}))cv.style.background=coverCss(cur()),r.remove()};
  cv.appendChild(r);
}
new MutationObserver(decorate).observe($('view'),{childList:true,subtree:true});

/* tap a name or avatar in the feed → open that person's profile */
$('view').addEventListener('click',e=>{
  if(Z.tab!=='home')return;
  const t=e.target.closest('.pt-head .av, .pt-head b');if(!t)return;
  const p=ld('zv_posts').find(x=>x.id===t.closest('article').dataset.id);
  if(p&&p.uid!=='official')openProfile(p.uid);
});

/* ================= LOOP ================= */
function tick(){renderAccList();if(!Z.user)return;remember();scan();badges()}
setInterval(tick,2000);tick();
})();
</script>
