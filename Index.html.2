const FL=[
 {id:'none',n:['Normal','নরমাল']},
 {id:'vivid',n:['Vivid','ভিভিড'],c:1.15,s:1.5},
 {id:'warm',n:['Warm','ওয়ার্ম'],s:1.2,sp:.15,t:[255,140,0,.12]},
 {id:'cool',n:['Cool','কুল'],s:1.1,t:[0,120,255,.14]},
 {id:'mono',n:['Mono','মনো'],g:1,c:1.1},
 {id:'noir',n:['Noir','নোয়ার'],g:1,c:1.4,b:.9},
 {id:'sepia',n:['Sepia','সেপিয়া'],sp:.85},
 {id:'fade',n:['Fade','ফেড'],c:.85,b:1.08,s:.8,t:[255,255,255,.12]},
 {id:'dream',n:['Dreamy','ড্রিমি'],b:1.08,c:.92,s:1.2,t:[255,120,200,.14]},
 {id:'drama',n:['Drama','ড্রামা'],c:1.35,s:.9,b:.95},
 {id:'sunset',n:['Sunset','সানসেট'],s:1.3,t:[255,90,60,.2]},
 {id:'mint',n:['Mint','মিন্ট'],t:[0,255,180,.12]}
];
function filt(px,f){
  const b=f.b||1,c=f.c||1,s=f.s==null?1:f.s,g=f.g||0,sp=f.sp||0,t=f.t;
  for(let i=0;i<px.length;i+=4){
    let r=px[i]*b,gg=px[i+1]*b,bl=px[i+2]*b;
    r=(r-128)*c+128;gg=(gg-128)*c+128;bl=(bl-128)*c+128;
    const l=.299*r+.587*gg+.114*bl;
    r=l+(r-l)*s;gg=l+(gg-l)*s;bl=l+(bl-l)*s;
    if(g){r+=(l-r)*g;gg+=(l-gg)*g;bl+=(l-bl)*g}
    if(sp){const a=.393*r+.769*gg+.189*bl,e=.349*r+.686*gg+.168*bl,h=.272*r+.534*gg+.131*bl;r+=(a-r)*sp;gg+=(e-gg)*sp;bl+=(h-bl)*sp}
    if(t){const a=t[3];r+=(t[0]-r)*a;gg+=(t[1]-gg)*a;bl+=(t[2]-bl)*a}
    px[i]=r;px[i+1]=gg;px[i+2]=bl;
  }
}
function draw(cv,im,max,f,sq){
  let sx=0,sy=0,sw=im.width,sh=im.height;
  if(sq){const m=Math.min(sw,sh);sx=(sw-m)/2;sy=(sh-m)/2;sw=sh=m}
  const s=Math.min(1,max/Math.max(sw,sh));cv.width=Math.round(sw*s);cv.height=Math.round(sh*s);
  const x=cv.getContext('2d');x.drawImage(im,sx,sy,sw,sh,0,0,cv.width,cv.height);
  if(f&&f.id!=='none'){const d=x.getImageData(0,0,cv.width,cv.height);filt(d.data,f);x.putImageData(d,0,0)}
}
const loadImg=f=>new Promise(res=>{const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>res(im);im.src=r.result};r.readAsDataURL(f)});
function editor(host,max){
  let im=null,fi=0;
  host.innerHTML='<canvas class="cvp hide"></canvas><div class="fstrip hide"></div>';
  const cv=host.firstChild,strip=host.lastChild,show=()=>draw(cv,im,max,FL[fi]);
  const build=()=>{strip.innerHTML='';FL.forEach((f,i)=>{
    const d=document.createElement('div');d.className='fth'+(i===fi?' on':'');
    const c=document.createElement('canvas');draw(c,im,72,f,true);d.appendChild(c);d.appendChild(document.createTextNode(f.n[Z.lang==='bn'?1:0]));
    d.onclick=()=>{fi=i;strip.querySelectorAll('.fth').forEach((x,j)=>x.classList.toggle('on',j===i));show()};strip.appendChild(d)})};
  return{
    async load(file){im=await loadImg(file);fi=0;cv.classList.remove('hide');strip.classList.remove('hide');show();build()},
    has:()=>!!im,
    bake(q=.78){const c=document.createElement('canvas');draw(c,im,max,FL[fi]);return c.toDataURL('image/jpeg',q)},
    filter:()=>FL[fi].id
  };
}

