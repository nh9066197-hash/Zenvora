Z.views.create=el=>{
  let music=null;
  el.innerHTML=`<div class="card"><textarea id="c8-t" class="inp" rows="4" maxlength="2000" placeholder="${Z.t('mind')}"></textarea>
  <select id="c8-c" class="inp">${['General','News','Entertainment','Education','Gaming','Business'].map(c=>`<option>${c}</option>`).join('')}</select>
  <div id="c8-e"></div>
  <label class="pick">📷 ${Z.t('photo')}<input id="c8-f" type="file" accept="image/*" hidden></label>
  <button class="mubtn" id="c8-m">🎵 <b>${Z.t('m_add')}</b><span class="sm">›</span></button>
  <button class="btn" id="c8-go">${Z.t('post')}</button></div>`;
  const ed=editor($('c8-e'),900);
  $('c8-f').onchange=e=>{if(e.target.files[0])ed.load(e.target.files[0])};
  $('c8-m').onclick=()=>pickMusic(music,m=>{music=m;$('c8-m').querySelector('b').textContent=m?'🎵 '+mname(m):Z.t('m_add')});
  $('c8-go').onclick=()=>{
    const text=$('c8-t').value.trim();
    if(!text&&!ed.has())return alert(Z.t('need'));
    const all=ld('zv_posts'),p={id:'p'+Date.now(),uid:Z.user.id,name:Z.user.name,text,img:ed.has()?ed.bake():'',cat:$('c8-c').value,ts:Date.now(),likes:[],saves:[],comments:[],shares:0};
    if(music)p.music=music;if(ed.has())p.filter=ed.filter();
    all.push(p);
    if(sv('zv_posts',all)){stopM();Z.tab='home';renderNav();render()}
  };
};

