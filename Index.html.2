function storyComposer(){
  const i=document.createElement('input');i.type='file';i.accept='image/*';
  i.onchange=()=>{
    if(!i.files[0])return;
    const old=$('sc8');if(old)old.remove();
    const d=document.createElement('div');d.id='sc8';d.className='ov7';
    d.innerHTML=`<div class="oh"><button class="ic" data-q="x">←</button><b style="flex:1;font-size:18px">${Z.t('s_new')}</b></div><div id="sc-e"></div>
    <button class="mubtn" data-q="m">🎵 <b>${Z.t('m_add')}</b><span class="sm">›</span></button><button class="btn" data-q="go">${Z.t('s_share')}</button>`;
    document.body.appendChild(d);
    const ed=editor(d.querySelector('#sc-e'),720);ed.load(i.files[0]);let music=null;
    d.onclick=e=>{
      const b=e.target.closest('[data-q]');if(!b)return;const q=b.dataset.q;
      if(q==='x'){stopM();d.remove()}
      else if(q==='m')pickMusic(music,m=>{music=m;b.querySelector('b').textContent=m?'🎵 '+mname(m):Z.t('m_add')});
      else if(q==='go'){
        if(!ed.has())return;
        const ss=ld('zv_stories'),s={id:'s'+Date.now(),uid:Z.user.id,name:Z.user.name,img:ed.bake(.8),ts:Date.now()};
        if(music)s.music=music;ss.push(s);
        if(sv('zv_stories',ss)){stopM();d.remove();alert(Z.t('s_ok'));if(Z.tab==='home')render()}
      }
    };
  };
  i.click();
}

