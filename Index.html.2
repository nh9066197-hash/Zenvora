const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ld=(k,d=[])=>{try{const v=JSON.parse(localStorage[k]);return v==null?d:v}catch(e){return d}};
const sv=(k,v)=>{try{localStorage[k]=JSON.stringify(v)}catch(e){alert(Z.t('full'))}};
const U=()=>ld('zv_users');
const cur=()=>U().find(u=>u.id===Z.user.id)||Z.user;
const isAdmin=()=>!!U()[0]&&U()[0].id===Z.user.id;
const fmtD=ts=>new Date(ts).toLocaleDateString();
const PACKS=[[50,100],[100,220],[500,1200]],RATE=0.35,MINWD=300,VIP=1000,DAY=864e5;
const GIFTS=[['🌹',10],['❤️',50],['👑',200],['🚀',500]];
const bd=u=>u.verified==='vip_pro'?'<span class="bdg vip">👑 PRO</span>':u.verified==='identity'?'<span class="bdg id">✔</span>':'';

function patch(id,fn){
  const L=U(),u=L.find(x=>x.id===id);if(!u)return null;
  fn(u);sv('zv_users',L);
  if(Z.user&&Z.user.id===id)Object.assign(Z.user,u);
  return u;
}
function tx(uid,text,coins){const L=ld('zv_tx');L.push({uid,text,coins,ts:Date.now()});sv('zv_tx',L.slice(-400))}
function chk(id){
  const u=U().find(x=>x.id===id);if(!u)return;
  const v=(u.vipUntil&&u.vipUntil>Date.now())?'vip_pro':(u.idv?'identity':'none');
  if(v!==u.verified)patch(id,x=>x.verified=v);
}
const hd=t=>`<div style="display:flex;align-items:center;gap:10px;margin-bottom:12px"><button class="ic" data-a="back">←</button><b style="font-size:17px">${t}</b></div>`;
function modal5(html){
  const d=document.createElement('div');d.className='m4';d.innerHTML=`<div class="m4b">${html}</div>`;
  d.addEventListener('click',e=>{if(e.target===d)d.remove()});document.body.appendChild(d);return d;
}

let root,scr='home',lastUid=null;

/* ---------- Profile home ---------- */
function home(el){
  const u=cur();
  const tiles=[['wallet','🪙',Z.t('p_wallet')],['verify','✅',Z.t('p_ver')],['studio','📈',Z.t('p_studio')],['settings','⚙️',Z.t('p_set')]];
  if(isAdmin())tiles.push(['admin','🛡️',Z.t('p_admin')]);
  el.innerHTML=`<div class="card" style="text-align:center"><div class="avatar">${esc(u.name[0].toUpperCase())}</div>
  <h3>${esc(u.name)}${bd(u)}</h3><p class="sm">${esc(u.email)}</p>${u.bio?`<p style="margin-top:8px">${esc(u.bio)}</p>`:''}
  <p style="margin-top:12px">🪙 ${u.coins||0} &nbsp; 💰 ${u.earn||0} &nbsp; 👥 ${u.followers||0}</p></div>
  <div class="p5-grid">${tiles.map(([s,i,l])=>`<button class="tile" data-a="go" data-s="${s}"><span>${i}</span>${l}</button>`).join('')}</div>
  <button class="btn" data-a="logout">${Z.t('out')}</button>`;
}

/* ---------- Wallet ---------- */
function wallet(el){
  const u=cur(),h=ld('zv_tx').filter(t=>t.uid===u.id).slice(-8).reverse();
  el.innerHTML=hd('🪙 '+Z.t('p_wallet'))+
  `<div class="card" style="text-align:center"><div style="font-size:30px;font-weight:700">🪙 ${u.coins||0}</div>
  <div class="sm">${Z.t('p_earn')}: 💰 ${u.earn||0} (≈ ৳${Math.floor((u.earn||0)*RATE)})</div></div>
  <div class="card"><h4>${Z.t('p_buy')}</h4>
  <select class="inp" id="w-m"><option>bKash</option><option>Nagad</option><option>Rocket</option><option>Card</option></select>
  ${PACKS.map(([b,c])=>`<div class="pk"><b>🪙 ${c}</b><button class="mini ok" style="padding:8px 16px;font-size:14px" data-a="buy" data-b="${b}" data-c="${c}">৳${b}</button></div>`).join('')}
  <p class="sm">${Z.t('p_demo')}</p></div>
  <div class="card"><h4>${Z.t('p_wd')}</h4><p class="sm" style="margin-bottom:8px">${Z.t('p_wdi')}</p>
  <select class="inp" id="w-wm"><option>bKash</option><option>Nagad</option><option>Rocket</option></select>
  <input class="inp" id="w-n" inputmode="numeric" maxlength="14" placeholder="${Z.t('p_num')}">
  <button class="btn" data-a="wd">${Z.t('p_req')}</button></div>
  <div class="card"><h4>${Z.t('p_hist')}</h4>${h.map(t=>`<div class="sw"><span style="font-size:13px">${esc(t.text)}<br><span class="sm">${fmtD(t.ts)}</span></span><b style="color:${t.coins>=0?'#16a34a':'#dc2626'}">${t.coins>0?'+':''}${t.coins}</b></div>`).join('')||'<p class="sm">—</p>'}</div>`;
}

/* ---------- Verification (two tiers) ---------- */
function verify(el){
  const u=cur(),req=ld('zv_vreq').filter(r=>r.uid===u.id).pop(),vip=u.verified==='vip_pro';
  let f1;
  if(u.idv)f1=`<p>${Z.t('p_have')}</p>`;
  else if(req&&req.status==='pending')f1=`<p>⏳ ${Z.t('p_pend')}</p>`;
  else f1=(req&&req.status==='rejected'?`<p style="color:var(--pink);margin-bottom:8px">${Z.t('p_rej')}</p>`:'')+
    `<input class="inp" id="v-n" maxlength="80" placeholder="${Z.t('p_legal')}"><input class="inp" id="v-t" maxlength="300" placeholder="${Z.t('p_note')}"><button class="btn" data-a="vreq">${Z.t('p_submit')}</button>`;
  el.innerHTML=hd('✅ '+Z.t('p_ver'))+
  `<div class="card"><h4>${Z.t('p_v1')} <span class="bdg id">✔</span></h4><p class="sm" style="margin-bottom:10px">${Z.t('p_v1d')}</p>${f1}</div>
  <div class="card"><h4>${Z.t('p_v2')} <span class="bdg vip">👑 PRO</span></h4><p class="sm" style="margin-bottom:10px">${Z.t('p_v2d')}</p>
  ${vip?`<p style="margin-bottom:8px">${Z.t('p_until')}: ${fmtD(u.vipUntil)}</p>`:''}
  <button class="btn" data-a="vip">${vip?Z.t('p_renew'):Z.t('p_sub')} · 🪙 ${VIP}</button></div>`;
}

/* ---------- Creator Studio ---------- */
function studio(el){
  const u=cur(),vs=ld('zv_videos').filter(v=>v.uid===u.id),ps=ld('zv_posts').filter(p=>p.uid===u.id);
  const views=vs.reduce((s,v)=>s+v.views,0),vl=vs.reduce((s,v)=>s+v.likes.length,0),pl=ps.reduce((s,p)=>s+p.likes.length,0);
  el.innerHTML=hd('📈 '+Z.t('p_studio'))+
  `<div class="p5-grid">${[['👁',views,'p_vv'],['❤️',vl,'p_vl'],['👍',pl,'p_pl'],['🎁',u.gifts||0,'p_gift']].map(([i,n,k])=>`<div class="tile" style="cursor:default"><span>${i}</span><b style="font-size:20px">${n}</b><div class="sm">${Z.t(k)}</div></div>`).join('')}</div>
  <div class="card sm">${Z.t('p_ad')}</div>`;
}

/* ---------- Settings ---------- */
function settings(el){
  const u=cur(),dark=localStorage.zv_theme==='dark';
  el.innerHTML=hd('⚙️ '+Z.t('p_set'))+
  `<div class="card"><h4>${Z.t('p_acc')}</h4><input class="inp" id="s-n" maxlength="50" value="${esc(u.name)}" placeholder="${Z.t('p_nm')}">
  <input class="inp" id="s-b" maxlength="160" value="${esc(u.bio||'')}" placeholder="${Z.t('p_bio')}"><button class="btn" data-a="saveacc">${Z.t('p_save')}</button></div>
  <div class="card"><h4>${Z.t('p_priv')}</h4><div class="sw"><span>${Z.t('p_pa')}</span><button class="tg5 ${u.private?'on':''}" data-a="priv"></button></div></div>
  <div class="card"><h4>${Z.t('p_sec')}</h4><input class="inp" id="s-p" type="password" autocomplete="new-password" placeholder="${Z.t('p_np')}"><button class="btn" data-a="pw">${Z.t('p_cp')}</button></div>
  <div class="card"><div class="sw"><span>🌙 ${Z.t('p_th')}</span><button class="tg5 ${dark?'on':''}" data-a="theme"></button></div>
  <div class="sw"><span>🌐 ${Z.t('p_lang')}</span><button class="mini ok" style="background:var(--blue);padding:8px 14px" data-a="lang">⇄</button></div>
  <div class="sw"><span>📦 ${Z.t('p_ex')}</span><button class="mini ok" style="background:var(--blue);padding:8px 14px" data-a="export">⬇</button></div></div>
  <button class="btn" style="background:#dc2626;box-shadow:none" data-a="delacc">${Z.t('p_del')}</button>`;
}

/* ---------- Super Admin ---------- */
function admin(el){
  if(!isAdmin()){el.innerHTML=hd('🛡️ '+Z.t('p_admin'))+`<div class="ph">${Z.t('p_only')}</div>`;return}
  const us=U(),now=Date.now(),act=us.filter(u=>now-(u.seen||u.created||0)<DAY).length;
  const rev=ld('zv_buys').reduce((s,b)=>s+b.bdt,0),circ=us.reduce((s,u)=>s+(u.coins||0)+(u.earn||0),0);
  const vq=ld('zv_vreq').filter(r=>r.status==='pending'),wq=ld('zv_wd').filter(r=>r.status==='pending');
  const posts=ld('zv_posts').sort((a,b)=>b.ts-a.ts).slice(0,6);
  const stats=[['👥',us.length,'p_tu'],['🟢',act,'p_au'],['📝',ld('zv_posts').length,'p_po'],['🎬',ld('zv_videos').length,'p_vi'],['📄',ld('zv_pages').length,'p_pg'],['🪙',circ,'p_cc']];
  const btn=(a,id)=>`<button class="mini ok" data-a="${a}ok" data-id="${id}">✔</button><button class="mini no" data-a="${a}no" data-id="${id}">✕</button>`;
  el.innerHTML=hd('🛡️ '+Z.t('p_admin'))+
  `<div class="p5-grid">${stats.map(([i,n,k])=>`<div class="tile" style="cursor:default"><span>${i}</span><b style="font-size:20px">${n}</b><div class="sm">${Z.t(k)}</div></div>`).join('')}</div>
  <div class="card" style="text-align:center"><div class="sm">${Z.t('p_rev')}</div><b style="font-size:24px">৳${rev}</b></div>
  <div class="card"><h4>✅ ${Z.t('p_vq')} (${vq.length})</h4><table class="tbl">${vq.map(r=>`<tr><td><b>${esc(r.legal)}</b><br><span class="sm">@${esc(r.name)}${r.note?' · '+esc(r.note):''}</span></td><td style="text-align:right;white-space:nowrap">${btn('v',r.id)}</td></tr>`).join('')||`<tr><td class="sm">${Z.t('p_none')}</td></tr>`}</table></div>
  <div class="card"><h4>💸 ${Z.t('p_wq')} (${wq.length})</h4><table class="tbl">${wq.map(r=>`<tr><td><b>৳${r.bdt}</b> · ${esc(r.method)} ${esc(r.num)}<br><span class="sm">@${esc(r.name)} · ${r.coins} 🪙</span></td><td style="text-align:right;white-space:nowrap">${btn('w',r.id)}</td></tr>`).join('')||`<tr><td class="sm">${Z.t('p_none')}</td></tr>`}</table></div>
  <div class="card"><h4>📝 ${Z.t('p_rp')}</h4><table class="tbl">${posts.map(p=>`<tr><td><b>${esc(p.name)}</b><br><span class="sm">${esc((p.text||'📷').slice(0,50))}</span></td><td style="text-align:right"><button class="mini no" data-a="pdel" data-id="${p.id}">🗑</button></td></tr>`).join('')}</table></div>
  <p class="sm" style="text-align:center">${Z.t('p_adm')}</p>`;
}

/* ---------- Gift hook (used by Live in Part 4) ---------- */
Z.sendGift=({liveId})=>{
  const L=ld('zv_lives'),l=L.find(x=>x.id===liveId);
  if(!l||l.uid===Z.user.id)return;
  const d=modal5(`<h3>🎁 ${Z.t('p_gt')}</h3><p class="sm">🪙 ${cur().coins||0}</p><div class="gf">${GIFTS.map(([e,c])=>`<button data-g="${c}" data-e="${e}"><span>${e}</span>🪙 ${c}</button>`).join('')}</div>`);
  d.addEventListener('click',e=>{
    const b=e.target.closest('[data-g]');if(!b)return;
    const c=+b.dataset.g,m=cur();
    if((m.coins||0)<c){alert(Z.t('p_low'));return}
    const got=Math.floor(c*.7);
    patch(m.id,x=>x.coins=(x.coins||0)-c);
    patch(l.uid,x=>{x.earn=(x.earn||0)+got;x.gifts=(x.gifts||0)+got});
    tx(m.id,'🎁 → @'+l.name,-c);tx(l.uid,'🎁 ← @'+m.name,got);
    const L2=ld('zv_lives'),l2=L2.find(x=>x.id===liveId);
    if(l2){l2.c.push({uid:m.id,name:m.name,text:b.dataset.e+' '+Z.t('p_sent')+' '+c+' 🪙',ts:Date.now()});sv('zv_lives',L2)}
    d.remove();
  });
};

/* ---------- Events ---------- */
async function click(e){
  const b=e.target.closest('[data-a]');if(!b)return;
  const a=b.dataset.a,id=b.dataset.id,uid=Z.user.id;
  switch(a){
    case 'go':scr=b.dataset.s;main(root);break;
    case 'back':scr='home';main(root);break;
    case 'logout':Z.logout();break;
    case 'buy':{
      const bdt=+b.dataset.b,c=+b.dataset.c,m=$('w-m').value;
      patch(uid,u=>u.coins=(u.coins||0)+c);
      const B=ld('zv_buys');B.push({uid,bdt,coins:c,method:m,ts:Date.now()});sv('zv_buys',B);
      tx(uid,'Buy ('+m+') ৳'+bdt,c);alert(Z.t('p_bought'));wallet(root);break}
    case 'wd':{
      const u=cur(),num=$('w-n').value.replace(/[\s-]/g,'');
      if((u.earn||0)<MINWD)return alert(Z.t('p_minwd'));
      if(!/^(\+?88)?01\d{9}$/.test(num))return alert(Z.t('p_badnum'));
      const W=ld('zv_wd'),c=u.earn;
      W.push({id:'w'+Date.now(),uid,name:u.name,coins:c,bdt:Math.floor(c*RATE),method:$('w-wm').value,num,ts:Date.now(),status:'pending'});sv('zv_wd',W);
      patch(uid,x=>x.earn=0);tx(uid,'Withdraw request',-c);alert(Z.t('p_wdok'));wallet(root);break}
    case 'vreq':{
      const n=$('v-n').value.trim();if(!n)return;
      const R=ld('zv_vreq');R.push({id:'vr'+Date.now(),uid,name:Z.user.name,legal:n,note:$('v-t').value.trim(),ts:Date.now(),status:'pending'});
      sv('zv_vreq',R);alert(Z.t('p_vsent'));verify(root);break}
    case 'vip':{
      const u=cur();if((u.coins||0)<VIP)return alert(Z.t('p_low'));
      patch(uid,x=>{x.coins-=VIP;x.vipUntil=Math.max(Date.now(),x.vipUntil||0)+30*DAY});
      tx(uid,'VIP PRO (30 days)',-VIP);chk(uid);alert(Z.t('p_vdone'));verify(root);break}
    case 'saveacc':{
      const n=$('s-n').value.trim();if(!n)return;
      patch(uid,u=>{u.name=n;u.bio=$('s-b').value.trim()});alert(Z.t('p_saved'));break}
    case 'priv':patch(uid,u=>u.private=!u.private);settings(root);break;
    case 'pw':{
      const p=$('s-p').value;if(p.length<6)return alert(Z.t('bad'));
      const h=await hash(p);patch(uid,u=>u.hash=h);$('s-p').value='';alert(Z.t('p_saved'));break}
    case 'theme':localStorage.zv_theme=(localStorage.zv_theme==='dark')?'light':'dark';applyTheme();settings(root);break;
    case 'lang':setLang();break;
    case 'export':{
      const u={...cur()};delete u.hash;
      const data={exportedAt:new Date().toISOString(),user:u,
        posts:ld('zv_posts').filter(p=>p.uid===uid),videos:ld('zv_videos').filter(v=>v.uid===uid),
        pages:ld('zv_pages').filter(p=>p.uid===uid),chats:ld('zv_chats').filter(c=>c.members.includes(uid)),
        wallet:ld('zv_tx').filter(t=>t.uid===uid)};
      const a2=document.createElement('a');a2.href=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:'application/json'}));
      a2.download='zenvora-my-data.json';document.body.appendChild(a2);a2.click();a2.remove();break}
    case 'delacc':{
      if(!confirm(Z.t('p_dc')))return;
      sv('zv_users',U().filter(u=>u.id!==uid));
      sv('zv_posts',ld('zv_posts').filter(p=>p.uid!==uid));
      sv('zv_stories',ld('zv_stories').filter(s=>s.uid!==uid));
      sv('zv_videos',ld('zv_videos').filter(v=>v.uid!==uid));
      sv('zv_pages',ld('zv_pages').filter(p=>p.uid!==uid));
      Z.logout();break}
    case 'vok':case 'vno':{
      const R=ld('zv_vreq'),r=R.find(x=>x.id===id);if(!r)return;
      r.status=a==='vok'?'approved':'rejected';sv('zv_vreq',R);
      if(a==='vok'){patch(r.uid,u=>u.idv=true);chk(r.uid)}
      admin(root);break}
    case 'wok':case 'wno':{
      const W=ld('zv_wd'),r=W.find(x=>x.id===id);if(!r)return;
      r.status=a==='wok'?'paid':'rejected';sv('zv_wd',W);
      if(a==='wno'){patch(r.uid,u=>u.earn=(u.earn||0)+r.coins);tx(r.uid,'Withdrawal refunded',r.coins)}
      admin(root);break}
    case 'pdel':sv('zv_posts',ld('zv_posts').filter(p=>p.id!==id));admin(root);break;
  }
}

function main(el){
  root=el;
  if(!Z.user)return;
  if(lastUid!==Z.user.id){lastUid=Z.user.id;scr='home'}
  chk(Z.user.id);
  el.onclick=click;
  ({home,wallet,verify,studio,settings,admin}[scr]||home)(el);
}
Z.views.profile=main;

/* active-user tracking + VIP expiry */
setInterval(()=>{if(Z.user){patch(Z.user.id,u=>u.seen=Date.now());chk(Z.user.id)}},20000);
})();
</script>
<!-- ===== PART 6: Premium Upgrade + New Profile + Settings hub ===== -->
<style>
body{background-image:radial-gradient(circle at 0 0,rgba(30,91,255,.12),transparent 40%),radial-gradient(circle at 100% 35%,rgba(138,43,226,.12),transparent 40%);background-attachment:fixed}
header{background:rgba(255,255,255,.78);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid rgba(120,130,170,.15)}
[data-theme=dark] header{background:rgba(11,15,36,.78)}
header h1{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;font-weight:800}
.ic{transition:.2s}.ic:active{transform:scale(.9)}
main{padding-bottom:112px}
main>*{animation:rise .35s ease both}
@keyframes rise{from{opacity:0;transform:translateY(8px)}}
nav{bottom:max(10px,env(safe-area-inset-bottom));width:calc(100% - 20px);max-width:460px;padding:4px;border:1px solid rgba(120,130,170,.2);border-radius:26px;background:rgba(255,255,255,.86);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);box-shadow:0 10px 30px rgba(20,30,80,.2)}
[data-theme=dark] nav{background:rgba(22,28,58,.88)}
nav button{border-radius:20px;transition:.25s}
