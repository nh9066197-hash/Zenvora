function consent(){
  const u=cur();if(!u||u.agreed||$('lk')||$('cn'))return;
  if(sessionStorage.zv_agree&&sessionStorage.zv_agree===u.email){patch(x=>x.agreed={ts:Date.now(),v:1});sessionStorage.removeItem('zv_agree');return}
  const d=modal10(`<h3 style="margin-bottom:8px">📜 ${Z.t('x_legal')}</h3><p style="margin-bottom:12px;line-height:1.5">${Z.t('x_terms_upd')}</p>
