nav button.on{background:linear-gradient(135deg,rgba(30,91,255,.15),rgba(138,43,226,.15))}
nav button.on span{transform:translateY(-2px) scale(1.15)}
.card,.post,.vc,.row4,.tile{box-shadow:0 2px 14px rgba(30,50,120,.07);border:1px solid rgba(120,130,170,.1)}
.btn,.chip,.tile,.row4{transition:transform .15s,box-shadow .2s}
.btn:active,.chip:active,.tile:active,.row4:active{transform:scale(.97)}
#toast{position:fixed;top:calc(14px + env(safe-area-inset-top));left:50%;transform:translate(-50%,-30px);opacity:0;background:#111a;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);background:rgba(15,20,40,.92);color:#fff;padding:11px 18px;border-radius:22px;z-index:300;transition:.3s;max-width:90%;pointer-events:none;font-size:14px;text-align:center}
#toast.on{transform:translate(-50%,0);opacity:1}
/* profile */
.pf-cover{height:132px;border-radius:22px;position:relative;margin-bottom:-46px}
.pf-ic{position:absolute;top:10px;right:10px;background:rgba(255,255,255,.28);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:0;border-radius:50%;width:40px;height:40px;font-size:18px;cursor:pointer}
.pf-top{display:flex;justify-content:space-between;align-items:flex-end;padding:0 14px;position:relative}
.pf-av{width:94px;height:94px;border-radius:50%;border:4px solid var(--bg);background:var(--grad);display:flex;align-items:center;justify-content:center;font-size:38px;color:#fff;overflow:hidden;box-shadow:0 6px 18px rgba(0,0,0,.22)}
.pf-av img{width:100%;height:100%;object-fit:cover}
.pf-edit{background:var(--card);border:0;border-radius:20px;padding:9px 16px;font-weight:600;cursor:pointer;color:var(--text)}
.pf-name{font-size:21px;font-weight:800;margin-top:10px;padding:0 4px}
.pf-bio{padding:6px 4px 0;line-height:1.5;white-space:pre-wrap;word-break:break-word}
.pf-st{display:flex;margin:14px 0;background:var(--card);border-radius:18px;padding:12px 0}
.pf-st div{flex:1;text-align:center;font-size:12px;color:var(--muted)}
.pf-st b{display:block;font-size:19px;color:var(--text)}
.pf-tabs{display:flex;border-bottom:1px solid var(--card);margin-bottom:10px}
.pf-tabs button{flex:1;background:none;border:0;padding:11px 0;color:var(--muted);font-weight:600;border-bottom:3px solid transparent;cursor:pointer;font-size:14px}
.pf-tabs button.on{color:var(--blue);border-color:var(--purple)}
.gd{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
.gd>div{aspect-ratio:1;border-radius:12px;overflow:hidden;position:relative;background:var(--card);cursor:pointer}
.gd img,.gd video{width:100%;height:100%;object-fit:cover;display:block;background:#000}
.gd .tx{padding:9px;font-size:12px;overflow:hidden;line-height:1.35;background:var(--grad);color:#fff;width:100%;height:100%;word-break:break-word}
.gd .ov{position:absolute;left:0;right:0;bottom:0;padding:14px 6px 4px;font-size:11px;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.7))}
.sethead{display:flex;align-items:center;gap:10px;margin-bottom:14px;font-size:18px;font-weight:700}
.cvs{display:flex;gap:10px;margin:6px 0 14px}
