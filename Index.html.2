.st4 b{display:block;font-size:18px;color:var(--text)}
</style>

<script>
(function(){
const $=Z.$;
Object.assign(Z.T.en,{c_chats:'Chats',c_pages:'Pages',c_live:'Live',c_new:'New chat',c_grp:'New group',c_gname:'Group name',c_mk:'Create',c_nou:'No other accounts on this device yet. Sign up with another account to start chatting.',c_msg:'Message…',c_none:'No chats yet. Start one!',c_mem:'members',c_nomic:'Microphone not available.',c_pg:'New page',c_pn:'Page name',c_pd:'About this page',c_nop:'No pages yet.',c_fol:'Follow',c_unf:'Following',c_post:'Post',c_say:'Share an update…',c_dash:'Dashboard',c_reach:'Reach',c_eng:'Likes',c_fw:'Followers',c_gr:'New followers (last 7 days)',c_gl:'Go Live',c_lt:'Live title',c_nocam:'Camera/mic not available. Use HTTPS or localhost and allow permission.',c_nolive:'Nobody is live right now.',c_end:'End',c_leave:'Leave',c_say2:'Say something…',c_gs:'Gifts arrive with the Coins system in Part 5.',c_vo:'Live video needs a streaming server. In this demo only comments and the viewer counter sync.',c_you:'You'});
Object.assign(Z.T.bn,{c_chats:'চ্যাট',c_pages:'পেজ',c_live:'লাইভ',c_new:'নতুন চ্যাট',c_grp:'নতুন গ্রুপ',c_gname:'গ্রুপের নাম',c_mk:'তৈরি করুন',c_nou:'এই ডিভাইসে আর কোনো অ্যাকাউন্ট নেই। চ্যাট করতে আরেকটি অ্যাকাউন্ট খুলুন।',c_msg:'মেসেজ…',c_none:'এখনো কোনো চ্যাট নেই। শুরু করুন!',c_mem:'সদস্য',c_nomic:'মাইক্রোফোন পাওয়া যায়নি।',c_pg:'নতুন পেজ',c_pn:'পেজের নাম',c_pd:'পেজ সম্পর্কে',c_nop:'এখনো কোনো পেজ নেই।',c_fol:'ফলো',c_unf:'ফলোয়িং',c_post:'পোস্ট',c_say:'আপডেট শেয়ার করুন…',c_dash:'ড্যাশবোর্ড',c_reach:'রিচ',c_eng:'লাইক',c_fw:'ফলোয়ার',c_gr:'নতুন ফলোয়ার (গত ৭ দিন)',c_gl:'লাইভ যান',c_lt:'লাইভের শিরোনাম',c_nocam:'ক্যামেরা/মাইক পাওয়া যায়নি। HTTPS বা localhost ব্যবহার করুন এবং অনুমতি দিন।',c_nolive:'এখন কেউ লাইভে নেই।',c_end:'শেষ',c_leave:'বের হন',c_say2:'কিছু বলুন…',c_gs:'গিফট পার্ট ৫-এর কয়েন সিস্টেমের সাথে আসবে।',c_vo:'লাইভ ভিডিওর জন্য স্ট্রিমিং সার্ভার লাগে। এই ডেমোতে শুধু কমেন্ট ও ভিউয়ার কাউন্টার সিঙ্ক হয়।',c_you:'আপনি'});

const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ld=(k,d=[])=>{try{const v=JSON.parse(localStorage[k]);return v==null?d:v}catch(e){return d}};
const sv=(k,v)=>{try{localStorage[k]=JSON.stringify(v);return true}catch(e){alert(Z.t('full'));return false}};
const users=()=>ld('zv_users');
const uname=id=>(users().find(u=>u.id===id)||{}).name||'User';
const ago=ts=>{const m=Math.floor((Date.now()-ts)/6e4);return m<1?Z.t('now'):m<60?m+'m':m<1440?Math.floor(m/60)+'h':Math.floor(m/1440)+'d'};
const toData=(f,max=800)=>new Promise(res=>{const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const s=Math.min(1,max/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*s;c.height=im.height*s;c.getContext('2d').drawImage(im,0,0,c.width,c.height);res(c.toDataURL('image/jpeg',.72))};im.src=r.result};r.readAsDataURL(f)});
const me=()=>Z.user.id;
const CATS4=['Business','News','Entertainment','Education','Gaming','Creator'];
let root,sec='chats',cur=null,pg=null,lv=null,stream=null,rec=null,sig='';

function modal(html){
  const d=document.createElement('div');d.className='m4';d.innerHTML=`<div class="m4b">${html}</div>`;
  d.addEventListener('click',e=>{if(e.target===d)d.remove()});document.body.appendChild(d);return d;
}
function pickImg(cb){const i=document.createElement('input');i.type='file';i.accept='image/*';i.onchange=async()=>{if(i.files[0])cb(await toData(i.files[0]))};i.click()}

/* ---------- shell ---------- */
function main(el){root=el;draw()}
function draw(){
  const ch=(s,l)=>`<button class="chip ${sec===s?'on':''}" data-a="sec" data-s="${s}">${l}</button>`;
  root.innerHTML=`<div class="wbar">${ch('chats','💬 '+Z.t('c_chats'))}${ch('pages','📄 '+Z.t('c_pages'))}${ch('live','🔴 '+Z.t('c_live'))}</div><div id="c4"></div>`;
  const b=$('c4');
  if(sec==='chats')cur?room(b):chats(b);
  else if(sec==='pages')pg?pageV(b):pages(b);
  else lv?liveRoom(b):lives(b);
  root.onclick=click;
}

/* ---------- Messenger ---------- */
const last=c=>c.msgs.length?c.msgs[c.msgs.length-1].ts:(c.ts||0);
const title=c=>c.type==='group'?c.name:uname(c.members.find(x=>x!==me())||me());
const prev=m=>m.type==='img'?'📷':m.type==='voice'?'🎤':(m.uid===me()?Z.t('c_you')+': ':'')+m.text;

function chats(b){
  const L=ld('zv_chats').filter(c=>c.members.includes(me())).sort((a,c)=>last(c)-last(a));
  b.innerHTML=`<div class="sub4"><button class="chip on" data-a="newdm">＋ ${Z.t('c_new')}</button><button class="chip on" data-a="newgrp">👥 ${Z.t('c_grp')}</button></div>`+
  (L.map(c=>{const lm=c.msgs[c.msgs.length-1];return `<div class="row4" data-a="open" data-id="${c.id}"><div class="av">${c.type==='group'?'👥':esc(title(c)[0].toUpperCase())}</div><div class="t"><b>${esc(title(c))}</b><div>${lm?esc(prev(lm)):''}</div></div><small class="mt">${lm?ago(lm.ts):''}</small></div>`}).join('')||`<div class="ph">${Z.t('c_none')}</div>`);
}

function newChat(group){
  const others=users().filter(u=>u.id!==me());
  const d=modal(`<h3 style="margin-bottom:10px">${Z.t(group?'c_grp':'c_new')}</h3>`+(!others.length?`<p class="mt">${Z.t('c_nou')}</p>`:
    (group?`<input class="inp" id="g-n" maxlength="40" placeholder="${Z.t('c_gname')}">`:'')+
    others.map(u=>group
      ?`<label class="row4"><div class="av">${esc(u.name[0].toUpperCase())}</div><div class="t"><b>${esc(u.name)}</b></div><input type="checkbox" value="${u.id}"></label>`
      :`<div class="row4" data-pick="${u.id}"><div class="av">${esc(u.name[0].toUpperCase())}</div><div class="t"><b>${esc(u.name)}</b></div></div>`).join('')+
    (group?`<button class="btn" id="g-go">${Z.t('c_mk')}</button>`:'')));
  d.addEventListener('click',e=>{const p=e.target.closest('[data-pick]');if(p){d.remove();openDm(p.dataset.pick)}});
  const go=d.querySelector('#g-go');
  if(go)go.onclick=()=>{
    const ids=[...d.querySelectorAll('input[type=checkbox]:checked')].map(x=>x.value),n=d.querySelector('#g-n').value.trim();
    if(!ids.length||!n)return;
    const L=ld('zv_chats'),c={id:'g'+Date.now(),type:'group',name:n,members:[me(),...ids],msgs:[],ts:Date.now()};
    L.push(c);sv('zv_chats',L);d.remove();cur=c.id;draw();
  };
}
function openDm(o){
  const id='dm_'+[me(),o].sort().join('_'),L=ld('zv_chats');
  if(!L.find(c=>c.id===id)){L.push({id,type:'dm',members:[me(),o],msgs:[],ts:Date.now()});sv('zv_chats',L)}
  cur=id;draw();
}

function room(b){
  const c=ld('zv_chats').find(x=>x.id===cur);if(!c){cur=null;return chats(b)}
  b.innerHTML=`<div class="rh"><button class="ic" data-a="back">←</button><div class="av">${c.type==='group'?'👥':esc(title(c)[0].toUpperCase())}</div>
  <div><b>${esc(title(c))}</b>${c.type==='group'?`<div class="mt">${c.members.length} ${Z.t('c_mem')}</div>`:''}</div></div>
  <div class="msgs" id="ms"></div>
  <div class="ib"><button data-a="img">📷</button><button data-a="mic">🎤</button><input id="mi" maxlength="1000" placeholder="${Z.t('c_msg')}"><button class="go" data-a="send">➤</button></div>`;
  sig='';msgs();
  $('mi').onkeydown=e=>{if(e.key==='Enter')sendTxt()};
}
function msgs(){
  const ms=$('ms');if(!ms)return;
  const c=ld('zv_chats').find(x=>x.id===cur);if(!c)return;
  const s=c.msgs.length+'';if(s===sig)return;sig=s;
  ms.innerHTML=c.msgs.map(m=>`<div class="b ${m.uid===me()?'me':''}">${c.type==='group'&&m.uid!==me()?`<small>${esc(m.name)}</small>`:''}${m.type==='img'?`<img src="${m.data}" alt="">`:m.type==='voice'?`<audio controls src="${m.data}"></audio>`:esc(m.text)}<small style="text-align:right;margin:2px 0 0">${ago(m.ts)}</small></div>`).join('');
  ms.scrollTop=ms.scrollHeight;
}
function send(m){
  const L=ld('zv_chats'),c=L.find(x=>x.id===cur);if(!c)return;
  c.msgs.push({id:'m'+Date.now(),uid:me(),name:Z.user.name,ts:Date.now(),...m});
  if(sv('zv_chats',L))msgs();
}
function sendTxt(){const i=$('mi'),t=i.value.trim();if(!t)return;i.value='';send({type:'text',text:t})}
async function mic(btn){
  if(rec){rec.stop();return}
  try{
    const s=await navigator.mediaDevices.getUserMedia({audio:true}),ch=[],r=new MediaRecorder(s);
    const tt=setTimeout(()=>{if(r.state==='recording')r.stop()},30000);
    r.ondataavailable=e=>ch.push(e.data);
    r.onstop=()=>{s.getTracks().forEach(t=>t.stop());clearTimeout(tt);btn.classList.remove('rec');rec=null;
      const f=new FileReader();f.onload=()=>send({type:'voice',data:f.result});f.readAsDataURL(new Blob(ch,{type:r.mimeType}))};
    rec=r;r.start();btn.classList.add('rec');
  }catch(e){alert(Z.t('c_nomic'))}
}

/* ---------- Pages ---------- */
function pages(b){
  const P=ld('zv_pages').sort((a,c)=>c.followers.length-a.followers.length);
  b.innerHTML=`<div class="sub4"><button class="chip on" data-a="newpg">＋ ${Z.t('c_pg')}</button></div>`+
  (P.map(p=>`<div class="row4" data-a="pg" data-id="${p.id}"><div class="av">${esc(p.name[0].toUpperCase())}</div><div class="t"><b>${esc(p.name)}${p.uid===me()?' ⭐':''}</b><div>${esc(p.cat)} · ${p.followers.length} ${Z.t('c_fw')}</div></div></div>`).join('')||`<div class="ph">${Z.t('c_nop')}</div>`);
}
function newPage(){
  const d=modal(`<h3 style="margin-bottom:10px">${Z.t('c_pg')}</h3><input class="inp" id="n-n" maxlength="50" placeholder="${Z.t('c_pn')}">
  <select class="inp" id="n-c">${CATS4.map(c=>`<option>${c}</option>`).join('')}</select>
  <textarea class="inp" id="n-d" rows="3" maxlength="300" placeholder="${Z.t('c_pd')}"></textarea><button class="btn" id="n-go">${Z.t('c_mk')}</button>`);
  d.querySelector('#n-go').onclick=()=>{
    const name=d.querySelector('#n-n').value.trim();if(!name)return;
    const P=ld('zv_pages'),p={id:'pg'+Date.now(),uid:me(),name,cat:d.querySelector('#n-c').value,desc:d.querySelector('#n-d').value.trim(),followers:[],reach:[],posts:[],ts:Date.now()};
    P.push(p);sv('zv_pages',P);d.remove();pg=p.id;draw();
  };
}
function pageV(b){
  const P=ld('zv_pages'),p=P.find(x=>x.id===pg);if(!p){pg=null;return pages(b)}
  const m=me(),own=p.uid===m,fol=p.followers.some(f=>f.uid===m);
  if(!own&&!p.reach.includes(m)){p.reach.push(m);sv('zv_pages',P)}
  const likes=p.posts.reduce((s,x)=>s+x.likes.length,0),day=864e5,t0=new Date().setHours(0,0,0,0);
  const g=[6,5,4,3,2,1,0].map(i=>p.followers.filter(f=>f.ts>=t0-i*day&&f.ts<t0-i*day+day).length),mx=Math.max(1,...g);
  b.innerHTML=`<div class="rh"><button class="ic" data-a="back">←</button><div class="av">${esc(p.name[0].toUpperCase())}</div>
  <div style="flex:1"><b>${esc(p.name)}</b><div class="mt">${esc(p.cat)} · ${p.followers.length} ${Z.t('c_fw')}</div></div>
  ${own?'':`<button class="chip ${fol?'':'on'}" data-a="follow">${fol?Z.t('c_unf'):Z.t('c_fol')}</button>`}</div>
  ${p.desc?`<p class="card">${esc(p.desc)}</p>`:''}
  ${own?`<div class="card"><b>📊 ${Z.t('c_dash')}</b><div class="st4"><div><b>${p.reach.length}</b>${Z.t('c_reach')}</div><div><b>${likes}</b>${Z.t('c_eng')}</div><div><b>${p.followers.length}</b>${Z.t('c_fw')}</div></div>
  <div class="mt">${Z.t('c_gr')}</div><div class="gr">${g.map(n=>`<i style="height:${n/mx*100}%"></i>`).join('')}</div></div>
  <div class="card"><textarea class="inp" id="pp-t" rows="3" maxlength="1000" placeholder="${Z.t('c_say')}"></textarea><button class="btn" data-a="ppost">${Z.t('c_post')}</button></div>`:''}
  ${[...p.posts].reverse().map(x=>`<div class="card"><p style="white-space:pre-wrap;word-break:break-word">${esc(x.text)}</p><div class="mt" style="margin-top:6px">${ago(x.ts)}</div>
  <button class="chip ${x.likes.includes(m)?'on':''}" style="margin-top:8px" data-a="plike" data-id="${x.id}">${x.likes.includes(m)?'❤️':'🤍'} ${x.likes.length}</button></div>`).join('')}`;
}

/* ---------- Live ---------- */
const active=l=>!l.ended&&Date.now()-(+localStorage['zv_bt_'+l.id]||0)<10000;
function viewers(id){
  let n=0;const pre='zv_vw_'+id+'_',now=Date.now();
  for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(k.startsWith(pre)&&now-(+localStorage[k])<8000)n++}
  return n;
}
function lives(b){
  const L=ld('zv_lives').filter(active);
  b.innerHTML=`<div class="sub4"><button class="chip on" data-a="golive">🔴 ${Z.t('c_gl')}</button></div>`+
  (L.map(l=>`<div class="row4" data-a="join" data-id="${l.id}"><div class="av" style="background:#e11">●</div><div class="t"><b>${esc(l.title)}</b><div>@${esc(l.name)} · 👁 ${viewers(l.id)}</div></div></div>`).join('')||`<div class="ph">${Z.t('c_nolive')}</div>`);
}
async function goLive(){
  const title=(prompt(Z.t('c_lt'),'')||'').trim().slice(0,80)||Z.user.name+' Live';
  try{stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user'},audio:true})}catch(e){return alert(Z.t('c_nocam'))}
  const L=ld('zv_lives'),l={id:'l'+Date.now(),uid:me(),name:Z.user.name,title,ts:Date.now(),ended:0,c:[]};
  L.push(l);sv('zv_lives',L);localStorage['zv_bt_'+l.id]=Date.now();lv=l.id;draw();
}
function liveRoom(b){
  const l=ld('zv_lives').find(x=>x.id===lv);if(!l||l.ended){lv=null;stopStream();return lives(b)}
  const own=l.uid===me();
  b.innerHTML=`<div class="live"><span class="badge">● LIVE</span><span class="vwr" id="lvn">👁 0</span>${own?'<video id="lvv" autoplay playsinline muted></video>':Z.t('c_vo')}</div>
  <div class="mt" style="margin-top:6px"><b>${esc(l.title)}</b> · @${esc(l.name)}</div>
  <div class="lc" id="lcm"></div>
  <div class="ib"><input id="lci" maxlength="200" placeholder="${Z.t('c_say2')}"><button class="go" data-a="lsend">➤</button>
  ${own?`<button class="wd" data-a="lend">${Z.t('c_end')}</button>`:`<button data-a="gift">🎁</button><button class="wd" data-a="lleave">${Z.t('c_leave')}</button>`}</div>`;
  if(own&&stream)$('lvv').srcObject=stream;
  if(!own)localStorage['zv_vw_'+lv+'_'+me()]=Date.now();
  sig='';renderLive();
  $('lci').onkeydown=e=>{if(e.key==='Enter')lsend()};
}
function renderLive(){
  const l=ld('zv_lives').find(x=>x.id===lv);if(!l)return;
  const n=$('lvn');if(n)n.textContent='👁 '+viewers(l.id);
  const c=$('lcm');if(!c)return;
  const s=l.c.length+'';if(s===sig)return;sig=s;
  c.innerHTML=l.c.map(x=>`<div><b>${esc(x.name)}</b> ${esc(x.text)}</div>`).join('');c.scrollTop=c.scrollHeight;
}
function lsend(){
  const i=$('lci'),t=i.value.trim();if(!t)return;i.value='';
  const L=ld('zv_lives'),l=L.find(x=>x.id===lv);if(!l)return;
  l.c.push({uid:me(),name:Z.user.name,text:t,ts:Date.now()});sv('zv_lives',L);renderLive();
}
function stopStream(){if(stream){stream.getTracks().forEach(t=>t.stop());stream=null}}
function endLive(){
  stopStream();
  if(lv){const L=ld('zv_lives'),l=L.find(x=>x.id===lv);if(l&&l.uid===me()){l.ended=1;sv('zv_lives',L)}}
  lv=null;if(Z.tab==='chat'&&root)draw();
}

/* ---------- events ---------- */
async function click(e){
  const b=e.target.closest('[data-a]');if(!b)return;
  const a=b.dataset.a,id=b.dataset.id;
  switch(a){
    case 'sec':sec=b.dataset.s;draw();break;
    case 'newdm':newChat(0);break;
    case 'newgrp':newChat(1);break;
    case 'open':cur=id;draw();break;
    case 'back':cur=null;pg=null;draw();break;
    case 'send':sendTxt();break;
    case 'img':pickImg(d=>send({type:'img',data:d}));break;
    case 'mic':mic(b);break;
    case 'newpg':newPage();break;
    case 'pg':pg=id;draw();break;
    case 'follow':{const P=ld('zv_pages'),p=P.find(x=>x.id===pg),k=p.followers.findIndex(f=>f.uid===me());
      k<0?p.followers.push({uid:me(),ts:Date.now()}):p.followers.splice(k,1);sv('zv_pages',P);draw();break}
    case 'ppost':{const t=$('pp-t').value.trim();if(!t)return;const P=ld('zv_pages'),p=P.find(x=>x.id===pg);
      p.posts.push({id:'pp'+Date.now(),text:t,ts:Date.now(),likes:[]});sv('zv_pages',P);draw();break}
    case 'plike':{const P=ld('zv_pages'),x=P.find(q=>q.id===pg).posts.find(q=>q.id===id),k=x.likes.indexOf(me());
      k<0?x.likes.push(me()):x.likes.splice(k,1);sv('zv_pages',P);draw();break}
    case 'golive':goLive();break;
    case 'join':lv=id;draw();break;
    case 'lsend':lsend();break;
    case 'lend':endLive();break;
    case 'lleave':localStorage.removeItem('zv_vw_'+lv+'_'+me());lv=null;draw();break;
    case 'gift':Z.sendGift?Z.sendGift({liveId:lv}):alert(Z.t('c_gs'));break;
  }
}

/* ---------- realtime loop (same device, multiple tabs/accounts) ---------- */
setInterval(()=>{
  if(!Z.user)return;
  if(Z.tab!=='chat'){if(stream)endLive();return}
  if(sec==='chats'&&cur)msgs();
  else if(sec==='live'){
    if(lv){
      const l=ld('zv_lives').find(x=>x.id===lv);
      if(!l||l.ended){lv=null;stopStream();draw();return}
      if(l.uid===me())localStorage['zv_bt_'+lv]=Date.now();else localStorage['zv_vw_'+lv+'_'+me()]=Date.now();
      renderLive();
    }else if($('c4'))lives($('c4'));
  }
},2000);

Z.views.chat=main;
})();
</script>
<!-- ===== PART 5: Coins, Verification, Settings, Super Admin ===== -->
<style>
.p5-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.tile{background:var(--card);border-radius:16px;padding:14px;text-align:center;cursor:pointer;border:0;color:var(--text);font-size:14px}
.tile span{display:block;font-size:26px;margin-bottom:4px}
.bdg{display:inline-block;font-size:12px;border-radius:10px;padding:1px 8px;color:#fff;vertical-align:middle;margin-left:4px}
.bdg.id{background:var(--blue)}
.bdg.vip{background:linear-gradient(90deg,#f7b500,#ff7a00)}
.pk{display:flex;justify-content:space-between;align-items:center;background:var(--bg);border-radius:14px;padding:10px 14px;margin:8px 0}
.sw{display:flex;justify-content:space-between;align-items:center;padding:11px 0;border-bottom:1px solid var(--bg);gap:8px}
.tg5{width:46px;height:26px;border-radius:13px;background:var(--muted);border:0;position:relative;cursor:pointer;flex:none}
.tg5::after{content:'';position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:.2s}
.tg5.on{background:var(--blue)}
.tg5.on::after{left:23px}
.gf{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:10px 0}
.gf button{background:var(--card);border:0;border-radius:14px;padding:10px 4px;font-size:12px;cursor:pointer;color:var(--text)}
.gf button span{display:block;font-size:28px}
.sm{font-size:12px;color:var(--muted)}
.tbl{width:100%;font-size:13px;border-collapse:collapse}
.tbl td{padding:7px 4px;border-bottom:1px solid var(--bg);vertical-align:middle}
.mini{border:0;border-radius:10px;padding:5px 10px;cursor:pointer;color:#fff;font-size:12px;margin-left:4px}
.mini.ok{background:#16a34a}
.mini.no{background:#dc2626}
.card h4{margin-bottom:6px}
</style>

