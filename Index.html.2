<style>
:root{--blue:#1e5bff;--purple:#8a2be2;--pink:#ff2d75;--gold:#ffc107;--bg:#fff;--card:#f4f6ff;--text:#0a1a3c;--muted:#6b7694;--grad:linear-gradient(90deg,var(--blue),var(--purple))}
[data-theme=dark]{--bg:#0b0f24;--card:#161c3a;--text:#eef1ff;--muted:#9aa5cc}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:system-ui,-apple-system,"Noto Sans Bengali",sans-serif;background:var(--bg);color:var(--text);max-width:480px;margin:auto;position:relative;overflow-x:hidden}
button,input{font:inherit;color:inherit}
.hide{display:none!important}
/* splash */
#splash{position:fixed;inset:0;background:#fff;display:flex;align-items:center;justify-content:center;z-index:99;transition:opacity .6s}
#splash img{width:70%;max-width:300px;animation:pop 1.2s ease}
@keyframes pop{from{opacity:0;transform:scale(.7)}to{opacity:1;transform:scale(1)}}
/* auth */
#auth{padding:24px;text-align:center;padding-top:calc(16px + env(safe-area-inset-top))}
#auth img{width:210px}
#auth h2{margin:6px 0 18px}
.inp{display:block;width:100%;padding:14px 16px;margin-bottom:12px;border:0;border-radius:16px;background:var(--card);outline:none}
.btn{width:100%;padding:14px;border:0;border-radius:28px;background:var(--grad);color:#fff;font-weight:600;font-size:16px;box-shadow:0 6px 14px rgba(138,43,226,.3);cursor:pointer}
.link{background:none;border:0;color:var(--blue);margin-top:14px;cursor:pointer}
.tag{margin-top:10px;font-style:italic;color:var(--purple)}
#err{color:var(--pink);min-height:20px;margin-bottom:8px;font-size:14px}
/* app shell */
header{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:8px;padding:8px 12px;padding-top:calc(8px + env(safe-area-inset-top));background:var(--bg);border-bottom:1px solid var(--card)}
header img{height:34px}
header h1{font-size:18px;flex:1}
.ic{background:var(--card);border:0;width:38px;height:38px;border-radius:50%;font-size:17px;cursor:pointer}
main{padding:14px 14px 90px;min-height:calc(100% - 60px)}
nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;display:flex;background:var(--bg);border-top:1px solid var(--card);padding-bottom:env(safe-area-inset-bottom);z-index:5}
nav button{flex:1;background:none;border:0;padding:9px 0 7px;color:var(--muted);font-size:11px;cursor:pointer}
nav button span{display:block;font-size:22px}
nav button.on{color:var(--blue);font-weight:700}
.card{background:var(--card);border-radius:18px;padding:16px;margin-bottom:12px}
.avatar{width:84px;height:84px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;font-size:36px;color:#fff;margin:10px auto}
.ph{text-align:center;color:var(--muted);padding:60px 10px}
</style>
</head>
