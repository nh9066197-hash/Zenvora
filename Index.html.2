    const ver=u.verified!=='none',done=u.bonusClaimed||[];
    body=`<div class="card"><h4>🏆 ${Z.t('d_rwt')}</h4><p style="line-height:1.55">${Z.t('d_rwn')}</p>${ver?'':`<button class="btn" style="margin-top:10px" data-d="tab" data-t="verify">${Z.t('d_gov')}</button>`}</div>`+
    (vids.map(v=>{const cl=done.includes(v.id),st=cl?`✅ ${Z.t('d_rw1')} +${BONUS} 🪙`:v.views>=1e6?(ver?'…':`🔒 ${Z.t('d_rw2')}`):`⏳ ${Z.t('d_rw3')}`;
      return `<div class="card"><b>${esc(v.title.slice(0,50))}</b>${bar(v.views)}<div class="sm">👁 ${v.views.toLocaleString()} / 1,000,000 · ${st}</div></div>`}).join('')||`<div class="ph">${Z.t('s6_nov')}</div>`);
  }
  const d=document.createElement('div');d.id='db';d.className='ov7';
  d.innerHTML=`<div class="oh"><button class="ic" data-d="x">←</button><b style="flex:1;font-size:18px">📊 ${Z.t('d_title')}</b></div>
  <div class="wbar">${chip('overview',Z.t('d_ov'))}${chip('content',Z.t('d_ct'))}${chip('wallet','🪙 '+Z.t('d_wl'))}${chip('verify','✅ '+Z.t('d_vf'))}${chip('rewards','🏆 '+Z.t('d_rw'))}</div>${body}`;
  document.body.appendChild(d);
  d.onclick=e=>{
    const b=e.target.closest('[data-d]');if(!b)return;const a=b.dataset.d;
    if(a==='x')d.remove();
    else if(a==='tab')dash(b.dataset.t);
    else if(a==='buy')checkout(+b.dataset.p,'coins',+b.dataset.c);
    else if(a==='vip')checkout(VIP,'vip',0);
    else if(a==='wd')withdraw(d);
    else if(a==='vreq'){
      const n=d.querySelector('#d-vn').value.trim();if(!n)return;
      const R=ld('zv_vreq');R.push({id:'vr'+Date.now(),uid:me,name:u.name,legal:n,note:d.querySelector('#d-vt').value.trim(),ts:Date.now(),status:'pending'});
      sv('zv_vreq',R);alert(Z.t('p_vsent'));dash();
    }
  };
}
function checkout(p,kind,c){
  const m=modal8(`<h3 style="margin-bottom:10px">${kind==='vip'?'👑 '+Z.t('p_v2'):'🪙 '+c} · ${usd(p)}</h3>
  <select class="inp" id="k-m">${['Card','PayPal','bKash','Nagad','Rocket'].map(x=>`<option>${x}</option>`).join('')}</select>
  <button class="btn" id="k-go">${Z.t('d_pay')} ${usd(p)}</button><p class="sm" style="margin-top:10px">${Z.t('d_demo')}</p>`);
  m.querySelector('#k-go').onclick=()=>{
    const meth=m.querySelector('#k-m').value;
    if(kind==='vip')patch(x=>{x.vipUntil=Math.max(Date.now(),x.vipUntil||0)+30*864e5;x.verified='vip_pro'});
    else patch(x=>x.coins=(x.coins||0)+c);
    const B=ld('zv_buys');B.push({uid:Z.user.id,usd:p,bdt:p,coins:c,kind,method:meth,ts:Date.now()});sv('zv_buys',B);
    tx(Z.user.id,kind==='vip'?'VIP PRO (30 days) '+usd(p):'Buy coins ('+meth+') '+usd(p),kind==='vip'?0:c);
    m.remove();alert(Z.t(kind==='vip'?'p_vdone':'d_paid'));dash();
  };
}
function withdraw(d){
  const u=cur(),earn=u.earn||0,amt=cash(earn);
  if(amt<MINWD)return alert(Z.t('d_wdm'));
  const meth=d.querySelector('#d-wm').value,acct=d.querySelector('#d-wn').value.trim().replace(/[\s-]/g,'');
  const ok=meth==='PayPal'?/^\S+@\S+\.\S+$/.test(acct):/^(\+?88)?01\d{9}$/.test(acct);
  if(!ok)return alert(Z.t('d_badacct'));
  const W=ld('zv_wd');W.push({id:'w'+Date.now(),uid:u.id,name:u.name,coins:earn,bdt:amt,method:meth,num:acct,ts:Date.now(),status:'pending'});sv('zv_wd',W);
  patch(x=>x.earn=0);tx(u.id,'Payout request '+usd(amt),-earn);alert(Z.t('d_wdok'));dash();
}

/* ================= 1M-VIEW BONUS (verified creators, 50 coins per video) ================= */
function rewards(){
  if(!Z.user)return;const u=cur();if(!u||u.verified==='none')return;
  const done=u.bonusClaimed||[],hit=ld('zv_videos').filter(v=>v.uid===u.id&&v.views>=1e6&&!done.includes(v.id));
  if(!hit.length)return;
  patch(x=>{x.bonusClaimed=(x.bonusClaimed||[]).concat(hit.map(v=>v.id));x.coins=(x.coins||0)+BONUS*hit.length});
  const N=ld('zv_notif');
  hit.forEach(v=>{tx(u.id,'🏆 1M views bonus',BONUS);N.push({id:'n'+Date.now()+v.id,to:u.id,type:'gift',from:null,name:'ZENVORA',extra:BONUS,ts:Date.now(),read:false})});
  sv('zv_notif',N.slice(-300));
}
setInterval(rewards,3000);

/* ================= WIRING ================= */
$('view').addEventListener('click',e=>{
  const g=e.target.closest('[data-a="go"]');
  if(g&&['wallet','verify','studio'].includes(g.dataset.s)){e.stopPropagation();dash({wallet:'wallet',verify:'verify',studio:'overview'}[g.dataset.s]);return}
  if(e.target.closest('[data-a="addstory"]')){e.stopPropagation();storyComposer();return}
  const st=e.target.closest('.st[data-s]');
  if(st){const s=ld('zv_stories').find(x=>x.id===st.dataset.s);
    if(s&&s.music)setTimeout(()=>{playM(s.music,null);const iv=setInterval(()=>{if(!$('sv')){clearInterval(iv);stopM()}},300)},60)}
},true);

function decorate(){
  if(!Z.user)return;const v=$('view'),u=cur();
  if(pl&&pl.el&&!document.contains(pl.el))stopM();
  /* music bar on feed posts */
  v.querySelectorAll('article.post:not([data-mu])').forEach(a=>{a.dataset.mu=1;
    const p=ld('zv_posts').find(x=>x.id===a.dataset.id);if(!p||!p.music)return;
    const b=document.createElement('div');b.className='mubar';b.innerHTML=`<i class="pp">▶</i><span>🎵 ${esc(mname(p.music))}</span>`;
    b.onclick=()=>playM(p.music,b);a.querySelector('.pt-head').after(b)});
  /* profile: hide email, add Dashboard button */
  const nm=v.querySelector('.pf-name + .sm');
  if(nm&&nm.textContent.includes('@'))nm.textContent=Z.t('s6_joined')+' '+new Date(u.created||Date.now()).toLocaleDateString();
  const ed=v.querySelector('.pf-edit[data-x="edit"]');
  if(ed&&!ed.dataset.w){ed.dataset.w=1;const w=document.createElement('div');w.style.cssText='display:flex;gap:8px';ed.replaceWith(w);
    const db=document.createElement('button');db.className='pf-edit';db.textContent='📊 '+Z.t('d_title');db.onclick=()=>dash('overview');
    ed.textContent='✏️';ed.title=Z.t('s6_edit');w.append(db,ed)}
  /* settings hub: hide email, show dollars */
  const sc=v.querySelector('#s6c');
  if(sc){
    sc.querySelectorAll('.card > p.sm').forEach(p=>{if(p.textContent.trim()===u.email)p.remove()});
    if(sc.textContent.includes('৳')){
      const w=document.createTreeWalker(sc,NodeFilter.SHOW_TEXT),L=[];let n;
      while(n=w.nextNode())if(n.nodeValue.includes('৳'))L.push(n);
      L.forEach(n=>n.nodeValue=n.nodeValue.replace(/৳(\d+(?:\.\d+)?)/g,(m,x)=>'$'+(+x).toFixed(2)));
      const rv=sc.querySelector('b[style*="24px"]');
      if(rv)rv.textContent='$'+ld('zv_buys').reduce((s,b)=>s+(b.usd||0),0).toFixed(2);
    }
  }
}
new MutationObserver(decorate).observe($('view'),{childList:true,subtree:true});
})();
</script>
