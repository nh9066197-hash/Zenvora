<!-- Core (Part 1) -->
<script>
const Z = {
  lang: localStorage.zv_lang || 'bn',
  views: {},            // Parts 2-5 register screens here: Z.views.home = el => {...}
  user: null,
  T: {
    en:{login:'Welcome back',signup:'Create your account',name:'Full name',email:'Email',pass:'Password',
        goL:'Log In',goS:'Sign Up',toS:"No account? Sign Up",toL:'Already have an account? Log In',
        bad:'Enter a valid email and a password of 6+ characters',noName:'Enter your name',
        wrong:'Wrong email or password',exists:'This email is already registered',
        home:'Home',watch:'Watch',create:'Create',chat:'Chat',profile:'Profile',out:'Log Out',soon:'Coming in the next part'},
    bn:{login:'স্বাগতম, আবার!',signup:'নতুন অ্যাকাউন্ট খুলুন',name:'পুরো নাম',email:'ইমেইল',pass:'পাসওয়ার্ড',
        goL:'লগ ইন',goS:'সাইন আপ',toS:'অ্যাকাউন্ট নেই? সাইন আপ করুন',toL:'অ্যাকাউন্ট আছে? লগ ইন করুন',
        bad:'সঠিক ইমেইল ও ৬+ অক্ষরের পাসওয়ার্ড দিন',noName:'আপনার নাম দিন',
        wrong:'ইমেইল বা পাসওয়ার্ড ভুল',exists:'এই ইমেইল আগেই নিবন্ধিত',
        home:'হোম',watch:'ওয়াচ',create:'তৈরি',chat:'চ্যাট',profile:'প্রোফাইল',out:'লগ আউট',soon:'পরের পার্টে আসছে'}
  },
  t(k){return this.T[this.lang][k]||k},
  $:id=>document.getElementById(id),
  tabs:[['home','🏠'],['watch','▶️'],['create','➕'],['chat','💬'],['profile','👤']],
  tab:'home'
};

/* ---- storage (demo only: swap for a real backend later) ---- */
const DB = {
  get users(){try{return JSON.parse(localStorage.zv_users||'[]')}catch(e){return[]}},
  set users(v){localStorage.zv_users=JSON.stringify(v)}
};
async function hash(s){
  const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode('zv:'+s));
  return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('');
}

/* ---- theme & language ---- */
function applyTheme(){document.documentElement.dataset.theme=localStorage.zv_theme||'light'}
Z.$('b-theme').onclick=()=>{localStorage.zv_theme=(localStorage.zv_theme==='dark')?'light':'dark';applyTheme()};
function setLang(){Z.lang=Z.lang==='bn'?'en':'bn';localStorage.zv_lang=Z.lang;renderAuth();renderNav();render()}
Z.$('b-lang').onclick=setLang; Z.$('a-lang').onclick=setLang;

/* ---- auth ---- */
let isLogin=true;
function renderAuth(){
  Z.$('a-title').textContent=Z.t(isLogin?'login':'signup');
  Z.$('a-name').classList.toggle('hide',isLogin);
  Z.$('a-name').placeholder=Z.t('name');
  Z.$('a-email').placeholder=Z.t('email');
  Z.$('a-pass').placeholder=Z.t('pass');
  Z.$('a-go').textContent=Z.t(isLogin?'goL':'goS');
  Z.$('a-toggle').textContent=Z.t(isLogin?'toS':'toL');
  Z.$('err').textContent='';
}
Z.$('a-toggle').onclick=()=>{isLogin=!isLogin;renderAuth()};
function mirrorProfile(profile, authUser){
  const meta=authUser.user_metadata||{};
  const u={id:authUser.id,name:profile?.name||meta.name||authUser.email?.split('@')[0]||'ZENVORA User',email:authUser.email||'',bio:profile?.bio||'',verified:'none',coins:0,followers:0,following:0,created:profile?.created_at?new Date(profile.created_at).getTime():Date.now()};
  const users=DB.users,idx=users.findIndex(x=>x.id===u.id);
  if(idx>=0) users[idx]={...users[idx],...u}; else users.push(u);
  DB.users=users; return users.find(x=>x.id===u.id);
}
async function getCurrentProfile(authUser){
  const {data,error}=await supabaseClient.from('profiles').select('*').eq('id',authUser.id).maybeSingle();
  if(error) console.warn('Profile lookup:',error.message);
  return mirrorProfile(data,authUser);
}
Z.$('a-go').onclick=async()=>{
  const name=Z.$('a-name').value.trim(),email=Z.$('a-email').value.trim().toLowerCase(),pass=Z.$('a-pass').value;
  const err=m=>Z.$('err').textContent=Z.t(m);
  if(!/^\S+@\S+\.\S+$/.test(email)||pass.length<6)return err('bad');
  const btn=Z.$('a-go');btn.disabled=true;btn.textContent=Z.lang==='bn'?'অপেক্ষা করুন...':'Please wait...';
  try{
    if(isLogin){
      const {data,error}=await supabaseClient.auth.signInWithPassword({email,password:pass});
      if(error) throw error;
      const u=await getCurrentProfile(data.user);login(u);
    }else{
      if(!name)return err('noName');
      const {data,error}=await supabaseClient.auth.signUp({email,password:pass,options:{data:{name},emailRedirectTo:'https://nh9066197-hash.github.io/Zenvora/'}});
      if(error) throw error;
      if(data.session&&data.user){const u=await getCurrentProfile(data.user);login(u)}
      else {err(Z.lang==='bn'?'রেজিস্ট্রেশন হয়েছে। ইমেইলে পাঠানো লিংকে ক্লিক করে অ্যাকাউন্ট নিশ্চিত করুন, তারপর Login করুন।':'Sign-up successful. Confirm your account using the email link, then log in.');Z.$('a-pass').value='';}
    }
  }catch(e){
    const msg=(e.message||'').toLowerCase();
    if(msg.includes('invalid login')||msg.includes('invalid credentials'))err(Z.lang==='bn'?'ইমেইল বা পাসওয়ার্ড ভুল।':'Incorrect email or password.');
    else if(msg.includes('already registered')||msg.includes('already been registered'))err(Z.lang==='bn'?'এই ইমেইলে অ্যাকাউন্ট আগে থেকেই আছে। Login করুন।':'This email is already registered. Please log in.');
    else err((Z.lang==='bn'?'সমস্যা: ':'Error: ')+(e.message||'Connection failed'));
  }finally{btn.disabled=false;btn.textContent=Z.t(isLogin?'goL':'goS')}
};
function login(u){localStorage.zv_session=u.id;Z.user=u;Z.$('a-pass').value='';show('app')}
async function logout(){try{await supabaseClient.auth.signOut()}catch(e){console.warn(e)}localStorage.removeItem('zv_session');Z.user=null;show('auth')}
Z.logout=logout;

/* ---- navigation ---- */
function renderNav(){
  Z.$('nav').innerHTML=Z.tabs.map(([k,i])=>`<button data-k="${k}" class="${k===Z.tab?'on':''}"><span>${i}</span>${Z.t(k)}</button>`).join('');
  Z.$('nav').querySelectorAll('button').forEach(b=>b.onclick=()=>{Z.tab=b.dataset.k;renderNav();render()});
}
function render(){
  Z.$('h-title').textContent=Z.t(Z.tab);
  const v=Z.$('view');v.innerHTML='';
  if(Z.views[Z.tab])Z.views[Z.tab](v);
  else if(Z.tab==='profile')profileView(v);
  else v.innerHTML=`<div class="ph"><div style="font-size:48px">🚧</div>${Z.t('soon')}</div>`;
}
function profileView(v){
  const u=Z.user;
  v.innerHTML=`<div class="card" style="text-align:center"><div class="avatar">${u.name[0].toUpperCase()}</div>
  <h3>${u.name.replace(/</g,'&lt;')}</h3><p style="color:var(--muted)">${u.email}</p>
  <p style="margin:12px 0">🪙 ${u.coins} &nbsp; 👥 ${u.followers} &nbsp; ➡️ ${u.following}</p>
  <button class="btn" id="b-out">${Z.t('out')}</button></div>`;
  v.querySelector('#b-out').onclick=logout;
}

/* ---- boot ---- */
function show(w){
  ['auth','app'].forEach(id=>Z.$(id).classList.toggle('hide',id!==w));
  if(w==='app'){renderNav();render()} else renderAuth();
}
applyTheme();
setTimeout(async()=>{
  Z.$('splash').style.opacity=0;setTimeout(()=>Z.$('splash').remove(),600);
  try{
    const {data,error}=await supabaseClient.auth.getSession();
    if(error) throw error;
    if(data.session?.user){const u=await getCurrentProfile(data.session.user);login(u)}else show('auth');
  }catch(e){console.warn('Session restore failed:',e);show('auth')}
},900);
</script>

