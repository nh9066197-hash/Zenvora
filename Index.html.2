d_rwt:'১M ভিউ বোনাস',d_rwn:'ভেরিফাইড ক্রিয়েটর (ফ্রি আইডেন্টিটি ভেরিফাইড বা VIP PRO) যতবার তাদের কোনো ভিডিও ১,০০,০০০০ ভিউ ছোঁবে, প্রতিবার ৫০ বোনাস কয়েন পাবেন। বোনাস নিজে থেকেই ওয়ালেটে যোগ হবে, প্রতি ভিডিওতে একবার। ভেরিফাই হওয়ার আগে কোনো ভিডিও ১M পার করলে, ভেরিফাই হওয়ার সাথে সাথে বোনাস পাবেন।',d_rwb:'রিওয়ার্ড: +৫০ কয়েন',d_rw1:'পেয়েছেন',d_rw2:'পেতে ভেরিফাই করুন',d_rw3:'চলছে',d_gov:'ভেরিফাই হোন',d_nocnt:'এখনো দেখানোর মতো কিছু নেই। পোস্ট বা ভিডিও দিন!'});

const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ld=(k,d=[])=>{try{const v=JSON.parse(localStorage[k]);return v==null?d:v}catch(e){return d}};
const sv=(k,v)=>{try{localStorage[k]=JSON.stringify(v);return true}catch(e){alert(Z.t('full'));return false}};
const fmt=n=>n>=1e6?(n/1e6).toFixed(1)+'M':n>=1e3?(n/1e3).toFixed(1)+'K':n;
const usd=n=>'$'+Number(n).toFixed(2),cash=c=>+(c*0.005).toFixed(2);
const cur=()=>ld('zv_users').find(u=>u.id===Z.user.id)||Z.user;
function patch(fn){const L=ld('zv_users'),u=L.find(x=>x.id===Z.user.id);if(!u)return false;fn(u);if(!sv('zv_users',L))return false;Object.assign(Z.user,u);return true}
function tx(uid,text,coins){const L=ld('zv_tx');L.push({uid,text,coins,ts:Date.now()});sv('zv_tx',L.slice(-400))}
