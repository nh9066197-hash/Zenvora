/* ================= AUDIO STORE (own uploads) ================= */
const adb=()=>new Promise((res,rej)=>{const r=indexedDB.open('zv_audio',1);r.onupgradeneeded=()=>r.result.createObjectStore('a');r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)});
const putA=async(id,b)=>{const d=await adb();return new Promise((res,rej)=>{const t=d.transaction('a','readwrite');t.objectStore('a').put(b,id);t.oncomplete=res;t.onerror=()=>rej(t.error)})};
const getA=async id=>{try{const d=await adb();return await new Promise(res=>{const q=d.transaction('a').objectStore('a').get(id);q.onsuccess=()=>res(q.result);q.onerror=()=>res(null)})}catch(e){return null}};

