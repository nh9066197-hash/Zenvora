/* ================= 4) ACCOUNT LOCK (profile lock + PIN lock) ================= */
function lockV(){
  const u=cur();
  const d=overlay10('alk',head('🔒 '+Z.t('x_lock'))+
  `<div class="card"><div class="sw"><div><b>${Z.t('x_lp')}</b><div class="sm">${Z.t('x_lpd')}</div></div><button class="tg5 ${u.private?'on':''}" data-k="priv"></button></div></div>
  <div class="card"><b>${Z.t('x_pin')}</b><div class="sm" style="margin:4px 0 12px">${Z.t('x_pind')}</div>
  ${u.pinHash?`<div class="ab"><button class="btn" data-k="set">${Z.t('x_chpin')}</button><button class="btn sec" data-k="rm">${Z.t('x_rmpin')}</button></div><button class="btn" data-k="now">🔒 ${Z.t('x_locknow')}</button>`
  :`<button class="btn" data-k="set">${Z.t('x_setpin')}</button>`}</div>`);
  d.onclick=e=>{
    const b=e.target.closest('[data-k]');if(!b)return;const k=b.dataset.k;
    if(k==='x')d.remove();
    else if(k==='priv'){patch(x=>x.private=!x.private);lockV()}
    else if(k==='set')setPin();
    else if(k==='rm'){patch(x=>{delete x.pinHash});sessionStorage.removeItem('zv_unl');alert(Z.t('x_pinoff'));lockV()}
    else if(k==='now'){d.remove();sessionStorage.removeItem('zv_unl');showLock()}
  };
}
function setPin(){
  const m=modal10(`<h3 style="margin-bottom:10px">🔑 ${Z.t('x_pin')}</h3>
  <input class="inp" id="p1" type="password" inputmode="numeric" maxlength="4" placeholder="${Z.t('x_newpin')}">
  <input class="inp" id="p2" type="password" inputmode="numeric" maxlength="4" placeholder="${Z.t('x_cpin')}"><button class="btn" id="ps">${Z.t('x_save')}</button>`);
  m.querySelector('#ps').onclick=async()=>{
    const a=m.querySelector('#p1').value,b=m.querySelector('#p2').value;
    if(!/^\d{4}$/.test(a)||a!==b)return alert(Z.t('x_pinbad'));
    const h=await hash('pin:'+a);patch(x=>x.pinHash=h);sessionStorage.zv_unl=me();m.remove();alert(Z.t('x_pinok'));lockV();
  };
}
let pinBuf='',tries=0;
function showLock(){
  if($('lk')||!Z.user)return;
  const d=document.createElement('div');d.id='lk';
  d.innerHTML=`<img src="zenvora-icon.png" style="width:72px;border-radius:16px" alt=""><h3 style="margin-top:12px">${Z.t('x_enter')}</h3>
  <div class="dots"><i></i><i></i><i></i><i></i></div><div class="sm" id="lk-m" style="min-height:20px;color:var(--pink)"></div>
  <div class="pin">${[1,2,3,4,5,6,7,8,9,'',0,'⌫'].map(k=>k===''?'<span></span>':`<button data-n="${k}">${k}</button>`).join('')}</div>
  <button class="link" data-n="out">${Z.t('x_forgot')}</button>`;
  document.body.appendChild(d);pinBuf='';
  d.onclick=async e=>{
    const b=e.target.closest('[data-n]');if(!b)return;const n=b.dataset.n;
    if(n==='out'){d.remove();Z.logout();return}
    if(n==='⌫')pinBuf=pinBuf.slice(0,-1);else if(pinBuf.length<4)pinBuf+=n;
    d.querySelectorAll('.dots i').forEach((x,i)=>x.classList.toggle('on',i<pinBuf.length));
    if(pinBuf.length===4){
      const ok=(await hash('pin:'+pinBuf))===cur().pinHash;pinBuf='';
      if(ok){sessionStorage.zv_unl=me();tries=0;d.remove()}
      else{tries++;if(tries>=5){tries=0;d.remove();Z.logout();return}
        $('lk-m').textContent=Z.t('x_wrong')+' ('+tries+'/5)';
        setTimeout(()=>d.querySelectorAll('.dots i').forEach(x=>x.classList.remove('on')),200)}
    }
  };
}
function maybeLock(){if(Z.user&&cur().pinHash&&sessionStorage.zv_unl!==Z.user.id)showLock()}
let hid=0;
document.addEventListener('visibilitychange',()=>{
  if(document.hidden)hid=Date.now();
  else if(Z.user&&hid&&Date.now()-hid>60000&&cur().pinHash){sessionStorage.removeItem('zv_unl');maybeLock()}
});

/* ================= 5) REPORT + BLOCK ================= */
const blockedEither=uid=>ld('zv_blocks').some(b=>(b.by===me()&&b.who===uid)||(b.by===uid&&b.who===me()));
const isFriend=uid=>ld('zv_fr').some(f=>f.status==='accepted'&&((f.a===me()&&f.b===uid)||(f.a===uid&&f.b===me())));
const allowed=uid=>{
  if(!uid||uid==='official'||uid===me())return true;
  if(blockedEither(uid))return false;
  const o=users().find(u=>u.id===uid);
  return !(o&&o.private&&!isFriend(uid));
};
function doBlock(uid){
  if(!confirm(Z.t('x_bq')))return;
  const B=ld('zv_blocks');if(!B.some(b=>b.by===me()&&b.who===uid)){B.push({by:me(),who:uid,ts:Date.now()});sv('zv_blocks',B)}
  sv('zv_fr',ld('zv_fr').filter(f=>!((f.a===me()&&f.b===uid)||(f.a===uid&&f.b===me()))));
  ['op','fp'].forEach(i=>{const o=$(i);if(o)o.remove()});
  alert(Z.t('x_bdone'));render();
}
function reportDlg(type,target,owner,preview){
  const R=ld('zv_reports');
  if(R.some(r=>r.by===me()&&r.target===target&&r.type===type))return alert(Z.t('x_dup'));
  const rs=['spam','harass','hate','sexual','violence','scam','copy','other'];
  const d=modal10(`<h3 style="margin-bottom:10px">🚩 ${Z.t('x_why')}</h3>
  ${rs.map((r,i)=>`<label class="sw" style="cursor:pointer"><span>${Z.t('x_r_'+r)}</span><input type="radio" name="rr" value="${r}" ${i===0?'checked':''}></label>`).join('')}
  <textarea class="inp" id="rn" rows="2" maxlength="300" placeholder="${Z.t('x_note')}" style="margin-top:10px"></textarea><button class="btn" id="rs">${Z.t('x_send')}</button>`);
  d.querySelector('#rs').onclick=()=>{
    const r=d.querySelector('input[name=rr]:checked').value;
    R.push({id:'r'+Date.now(),by:me(),byName:Z.user.name,type,target,owner,ownerName:uname(owner),reason:r,note:d.querySelector('#rn').value.trim(),preview:String(preview||'').slice(0,80),ts:Date.now(),status:'open'});
    sv('zv_reports',R);d.remove();alert(Z.t('x_thanks'));
  };
}
function menu(type,target,owner,preview){
  const lab={post:'x_rpost',video:'x_rvid',user:'x_ruser'}[type];
  const d=modal10(`<div class="row4" data-m="r"><div class="av">🚩</div><div class="t"><b>${Z.t(lab)}</b></div></div>
  <div class="row4" data-m="b"><div class="av">🚫</div><div class="t"><b>${Z.t('x_block')} @${esc(uname(owner))}</b></div></div>`);
