function legal(tab){
  tab=tab||'terms';
  const L=LG[Z.lang],tabs=[['terms',Z.t('x_terms')],['privacy',Z.t('x_priv')],['rules',Z.t('x_rules')]];
  const d=overlay10('lgp',head('📜 '+Z.t('x_legal'))+`<div class="pf-tabs">${tabs.map(([k,l])=>`<button class="${k===tab?'on':''}" data-l="${k}">${l}</button>`).join('')}</div>
  <div class="lgt">${L[tab].map(([h,p])=>`<h4>${esc(h)}</h4><p>${esc(p)}</p>`).join('')}</div>`);
  d.onclick=e=>{if(e.target.closest('[data-k="x"]')){d.remove();return}const b=e.target.closest('[data-l]');if(b)legal(b.dataset.l)};
}

